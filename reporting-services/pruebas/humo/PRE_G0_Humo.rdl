<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="BI_OLIST_DW">
      <DataSourceReference>/OLIST360/DataSources/BI_OLIST_DW</DataSourceReference>
      <rd:DataSourceID>e8b54fa6-25d6-4df0-849e-4e7ce3a56012</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DatosHumo">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <CommandText>SELECT (SELECT COUNT_BIG(*) FROM dw.FactPedidos) AS pedidos, (SELECT COUNT_BIG(*) FROM dw.FactDetallePedido) AS lineas, SYSUTCDATETIME() AS fecha_ejecucion_utc;</CommandText>
      </Query>
      <Fields>
        <Field Name="pedidos">
          <DataField>pedidos</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="lineas">
          <DataField>lineas</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="fecha_ejecucion_utc">
          <DataField>fecha_ejecucion_utc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <Body>
    <ReportItems>
      <Textbox Name="Titulo">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>PRE-G0-06 | Prueba de humo OLIST 360</Value>
                <Style>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>White</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
