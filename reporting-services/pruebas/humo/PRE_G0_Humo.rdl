        <Height>0.9cm</Height>
        <Width>18.1cm</Width>
        <Style>
          <BackgroundColor>#101C32</BackgroundColor>
          <PaddingLeft>4pt</PaddingLeft>
          <PaddingTop>4pt</PaddingTop>
          <PaddingBottom>4pt</PaddingBottom>
        </Style>
      </Textbox>
      <Textbox Name="Pedidos">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=&quot;Pedidos en BI_OLIST: &quot; &amp; Format(First(Fields!pedidos.Value, &quot;DatosHumo&quot;), &quot;N0&quot;)</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#14233B</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Pedidos</rd:DefaultName>
