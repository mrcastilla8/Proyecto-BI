        <Height>0.8cm</Height>
        <Width>17.8cm</Width>
        <Style />
      </Textbox>
      <Textbox Name="Lineas">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=&quot;Líneas en BI_OLIST: &quot; &amp; Format(First(Fields!lineas.Value, &quot;DatosHumo&quot;), &quot;N0&quot;)</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#14233B</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Lineas</rd:DefaultName>
        <Top>2.7cm</Top>
