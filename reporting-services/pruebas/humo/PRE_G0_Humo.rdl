        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=&quot;Consulta ejecutada (UTC): &quot; &amp; Format(First(Fields!fecha_ejecucion_utc.Value, &quot;DatosHumo&quot;), &quot;yyyy-MM-dd HH:mm:ss&quot;)</Value>
                <Style>
                  <FontSize>9pt</FontSize>
                  <Color>#475569</Color>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>FechaEjecucion</rd:DefaultName>
