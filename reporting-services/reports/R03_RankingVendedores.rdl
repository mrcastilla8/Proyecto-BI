<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>OLIST 360° · R03 · Ranking de vendedores</Description>
  <Language>es-PE</Language>
  <DataSources>
    <DataSource Name="BI_OLIST_DW">
      <DataSourceReference>/OLIST360/DataSources/BI_OLIST_DW</DataSourceReference>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="FechasCompra">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <CommandText>SELECT MIN(f.fecha) AS desde, MAX(f.fecha) AS hasta
FROM dw.FactPedidos AS p
INNER JOIN dw.DimFecha AS f ON f.fecha_key = p.fecha_compra_key
WHERE f.fecha_key &lt;&gt; -1;
</CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="desde">
          <DataField>desde</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="hasta">
          <DataField>hasta</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Estados">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <CommandText>WITH estados AS (
    SELECT '__TODOS__' AS valor, N'Todos' AS etiqueta, 0 AS orden
    UNION ALL
    SELECT DISTINCT CONVERT(varchar(2), seller_state), CONVERT(nvarchar(2), seller_state), 1
    FROM dw.DimGeografiaVendedor
    WHERE seller_state IS NOT NULL
    UNION ALL
    SELECT '__DESCONOCIDO__', N'Desconocido', 2
    WHERE EXISTS (SELECT 1 FROM dw.DimGeografiaVendedor WHERE seller_state IS NULL)
)
SELECT valor, etiqueta
FROM estados
ORDER BY orden, etiqueta;
</CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="valor">
          <DataField>valor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="etiqueta">
          <DataField>etiqueta</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Resultados">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Desde">
            <Value>=Parameters!Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Hasta">
            <Value>=Parameters!Hasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EstadoVendedor">
            <Value>=Parameters!EstadoVendedor.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TopN">
            <Value>=Parameters!TopN.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT TOP (CASE WHEN @TopN IN (10,20,50) THEN @TopN ELSE 0 END) v.seller_id, v.vendedor_key, SUM(d.price) AS ventas, COUNT_BIG(DISTINCT d.order_id) AS entregados, CONVERT(float,SUM(d.price))/NULLIF(COUNT_BIG(DISTINCT d.order_id),0) AS ticket, SUM(d.freight_value) AS flete
FROM dw.FactDetallePedido d JOIN dw.DimFecha f ON f.fecha_key=d.fecha_compra_key JOIN dw.DimVendedor v ON v.vendedor_key=d.vendedor_key
JOIN dw.DimGeografiaVendedor g ON g.geografia_vendedor_key=d.geografia_vendedor_key
WHERE d.order_status='delivered' AND d.fecha_compra_key &lt;&gt; -1 AND f.fecha &gt;= CAST(@Desde AS date) AND f.fecha &lt;= CAST(@Hasta AS date) AND CAST(@Desde AS date) &lt;= CAST(@Hasta AS date) AND (@EstadoVendedor = '__TODOS__' OR (@EstadoVendedor = '__DESCONOCIDO__' AND g.seller_state IS NULL) OR g.seller_state = @EstadoVendedor)
GROUP BY v.seller_id,v.vendedor_key
ORDER BY ventas DESC,v.seller_id,v.vendedor_key;
</CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="seller_id">
          <DataField>seller_id</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="vendedor_key">
          <DataField>vendedor_key</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ventas">
          <DataField>ventas</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="entregados">
          <DataField>entregados</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="ticket">
          <DataField>ticket</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="flete">
          <DataField>flete</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Desde">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>FechasCompra</DataSetName>
          <ValueField>desde</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Compra desde</Prompt>
    </ReportParameter>
    <ReportParameter Name="Hasta">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>FechasCompra</DataSetName>
          <ValueField>hasta</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Compra hasta</Prompt>
    </ReportParameter>
    <ReportParameter Name="EstadoVendedor">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>__TODOS__</Value>
        </Values>
      </DefaultValue>
      <ValidValues>
        <DataSetReference>
          <DataSetName>Estados</DataSetName>
          <ValueField>valor</ValueField>
          <LabelField>etiqueta</LabelField>
        </DataSetReference>
      </ValidValues>
      <Prompt>Estado del vendedor</Prompt>
    </ReportParameter>
    <ReportParameter Name="TopN">
      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>10</Value>
        </Values>
      </DefaultValue>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>10</Value>
            <Label>10</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>20</Value>
            <Label>20</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>50</Value>
            <Label>50</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
      <Prompt>Máximo de vendedores</Prompt>
    </ReportParameter>
  </ReportParameters>
