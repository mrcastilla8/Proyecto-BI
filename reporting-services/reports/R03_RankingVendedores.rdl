            <NoRowsMessage>=IIf((IsNothing(Parameters!Desde.Value) OrElse IsNothing(Parameters!Hasta.Value) OrElse CDate(Parameters!Desde.Value).Date &gt; CDate(Parameters!Hasta.Value).Date) OrElse (Parameters!TopN.Value &lt;&gt; 10 AndAlso Parameters!TopN.Value &lt;&gt; 20 AndAlso Parameters!TopN.Value &lt;&gt; 50), "Revisa las fechas y los filtros antes de ejecutar.", "Sin vendedores para el período y estado seleccionados.")</NoRowsMessage>
