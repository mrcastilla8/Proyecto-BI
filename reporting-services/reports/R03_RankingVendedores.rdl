          <ReportItems>
            <Textbox Name="Titulo">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>Ranking de vendedores · R03</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>19pt</FontSize>
                        <Color>#FFFFFF</Color>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Left</TextAlign>
                  </Style>
                </Paragraph>
              </Paragraphs>
              <Top>0mm</Top>
              <Left>0mm</Left>
              <Width>270mm</Width>
              <Height>13mm</Height>
              <Style>
                <PaddingLeft>2mm</PaddingLeft>
                <PaddingRight>2mm</PaddingRight>
                <PaddingTop>1.4mm</PaddingTop>
                <PaddingBottom>1.4mm</PaddingBottom>
                <VerticalAlign>Middle</VerticalAlign>
                <BackgroundColor>#101C32</BackgroundColor>
              </Style>
            </Textbox>
            <Textbox Name="Filtros">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>=IIf(IsNothing(Parameters!Desde.Value) OrElse IsNothing(Parameters!Hasta.Value), "Período de compra pendiente", "Compra del " &amp; Format(Parameters!Desde.Value, "dd/MM/yyyy") &amp; " al " &amp; Format(Parameters!Hasta.Value, "dd/MM/yyyy")) &amp; " · Estado del vendedor " &amp; Parameters!EstadoVendedor.Label &amp; " · Top " &amp; Parameters!TopN.Value</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>10pt</FontSize>
                        <Color>#FFFFFF</Color>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Left</TextAlign>
                  </Style>
                </Paragraph>
              </Paragraphs>
              <Top>13mm</Top>
              <Left>0mm</Left>
              <Width>270mm</Width>
              <Height>10mm</Height>
              <Style>
                <PaddingLeft>2mm</PaddingLeft>
                <PaddingRight>2mm</PaddingRight>
                <PaddingTop>1.4mm</PaddingTop>
                <PaddingBottom>1.4mm</PaddingBottom>
                <VerticalAlign>Middle</VerticalAlign>
                <BackgroundColor>#101C32</BackgroundColor>
              </Style>
            </Textbox>
          </ReportItems>
        </PageHeader>
        <PageFooter>
          <Height>9mm</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>
            <Textbox Name="PiePagina">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>="OLIST 360° · Fuente: Olist · Página " &amp; Globals!PageNumber &amp; " de " &amp; Globals!TotalPages</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>9pt</FontSize>
                        <Color>#475569</Color>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Left</TextAlign>
                  </Style>
                </Paragraph>
              </Paragraphs>
              <Top>0mm</Top>
              <Left>0mm</Left>
              <Width>270mm</Width>
              <Height>8mm</Height>
              <Style>
                <PaddingLeft>2mm</PaddingLeft>
                <PaddingRight>2mm</PaddingRight>
                <PaddingTop>1.4mm</PaddingTop>
                <PaddingBottom>1.4mm</PaddingBottom>
                <VerticalAlign>Middle</VerticalAlign>
              </Style>
            </Textbox>
          </ReportItems>
        </PageFooter>
        <PageHeight>210mm</PageHeight>
        <PageWidth>297mm</PageWidth>
        <LeftMargin>12mm</LeftMargin>
        <RightMargin>12mm</RightMargin>
        <TopMargin>12mm</TopMargin>
        <BottomMargin>12mm</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
</Report>
