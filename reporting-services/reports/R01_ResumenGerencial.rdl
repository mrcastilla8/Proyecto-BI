          <Tablix Name="TablaResumenKPI">
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>6.2cm</Width></TablixColumn>
                <TablixColumn><Width>7.6cm</Width></TablixColumn>
                <TablixColumn><Width>4.2cm</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>0.65cm</Height>
                  <TablixCells>
