<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Resumen gerencial de los ocho indicadores oficiales de BI-OLIST mediante dos datasets independientes (detalle y cabecera).</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="BI_OLIST_DW">
      <DataSourceReference>/OLIST360/DataSources/BI_OLIST_DW</DataSourceReference>
      <rd:DataSourceID>3a8d0eab-78c4-40a2-b985-4d2d12649b24</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="R01_Fechas">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <CommandText><![CDATA[SELECT MIN(f.fecha) AS desde, MAX(f.fecha) AS hasta
FROM dw.FactPedidos AS p
JOIN dw.DimFecha AS f ON f.fecha_key = p.fecha_compra_key
WHERE f.fecha_key <> -1;]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="desde"><DataField>desde</DataField></Field>
        <Field Name="hasta"><DataField>hasta</DataField></Field>
      </Fields>
    </DataSet>
    <DataSet Name="R01_Estados">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <CommandText><![CDATA[SELECT estados.valor, estados.etiqueta
FROM (
    SELECT '__TODOS__' AS valor, N'Todos' AS etiqueta, 0 AS prioridad
    UNION ALL
    SELECT DISTINCT customer_state, customer_state, 1
    FROM dw.DimGeografiaCliente
    WHERE customer_state IS NOT NULL
    UNION ALL
    SELECT '__DESCONOCIDO__', N'Desconocido', 2
    WHERE EXISTS (
        SELECT 1 FROM dw.DimGeografiaCliente WHERE customer_state IS NULL
    )
) AS estados
ORDER BY estados.prioridad, estados.etiqueta;]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="valor"><DataField>valor</DataField></Field>
        <Field Name="etiqueta"><DataField>etiqueta</DataField></Field>
      </Fields>
    </DataSet>
    <DataSet Name="R01_ResumenDetalle">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Desde"><Value>=Parameters!Desde.Value</Value></QueryParameter>
          <QueryParameter Name="@Hasta"><Value>=Parameters!Hasta.Value</Value></QueryParameter>
          <QueryParameter Name="@EstadoCliente"><Value>=Parameters!EstadoCliente.Value</Value></QueryParameter>
        </QueryParameters>
        <CommandText><![CDATA[SELECT SUM(d.price) AS ventas,
       COUNT_BIG(DISTINCT d.order_id) AS entregados,
       CONVERT(float, SUM(d.price)) / NULLIF(COUNT_BIG(DISTINCT d.order_id), 0) AS ticket,
       SUM(d.freight_value) AS flete
FROM dw.FactDetallePedido AS d
JOIN dw.DimFecha AS f ON f.fecha_key = d.fecha_compra_key
JOIN dw.DimGeografiaCliente AS g ON g.geografia_cliente_key = d.geografia_cliente_key
WHERE d.order_status = 'delivered'
  AND d.fecha_compra_key <> -1
  AND f.fecha >= CAST(@Desde AS date)
  AND f.fecha <= CAST(@Hasta AS date)
  AND CAST(@Desde AS date) <= CAST(@Hasta AS date)
  AND (
      @EstadoCliente = '__TODOS__'
      OR (@EstadoCliente = '__DESCONOCIDO__' AND g.customer_state IS NULL)
      OR g.customer_state = @EstadoCliente
  );]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="ventas"><DataField>ventas</DataField></Field>
        <Field Name="entregados"><DataField>entregados</DataField></Field>
        <Field Name="ticket"><DataField>ticket</DataField></Field>
        <Field Name="flete"><DataField>flete</DataField></Field>
      </Fields>
    </DataSet>
    <DataSet Name="R01_ResumenCabecera">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Desde"><Value>=Parameters!Desde.Value</Value></QueryParameter>
          <QueryParameter Name="@Hasta"><Value>=Parameters!Hasta.Value</Value></QueryParameter>
          <QueryParameter Name="@EstadoCliente"><Value>=Parameters!EstadoCliente.Value</Value></QueryParameter>
        </QueryParameters>
        <CommandText><![CDATA[SELECT COUNT_BIG(*) AS pedidos,
       1.0 * SUM(CASE WHEN p.order_status = 'delivered' AND p.fecha_entrega_real_key <> -1 AND p.fecha_entrega_estimada_key <> -1 AND p.fecha_entrega_real_key <= p.fecha_entrega_estimada_key THEN CONVERT(bigint, 1) ELSE 0 END)
       / NULLIF(SUM(CASE WHEN p.order_status = 'delivered' AND p.fecha_entrega_real_key <> -1 AND p.fecha_entrega_estimada_key <> -1 THEN CONVERT(bigint, 1) ELSE 0 END), 0) AS puntualidad,
       AVG(CASE WHEN p.order_status = 'delivered' AND p.fecha_compra_key <> -1 AND p.fecha_entrega_real_key <> -1 THEN CONVERT(float, DATEDIFF_BIG(SECOND, p.order_purchase_timestamp, p.order_delivered_customer_date)) / 86400.0 END) AS dias,
       AVG(CONVERT(float, p.review_score)) AS nota
FROM dw.FactPedidos AS p
JOIN dw.DimFecha AS f ON f.fecha_key = p.fecha_compra_key
JOIN dw.DimGeografiaCliente AS g ON g.geografia_cliente_key = p.geografia_cliente_key
WHERE p.fecha_compra_key <> -1
  AND f.fecha >= CAST(@Desde AS date)
  AND f.fecha <= CAST(@Hasta AS date)
  AND CAST(@Desde AS date) <= CAST(@Hasta AS date)
  AND (
      @EstadoCliente = '__TODOS__'
      OR (@EstadoCliente = '__DESCONOCIDO__' AND g.customer_state IS NULL)
      OR g.customer_state = @EstadoCliente
  );]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="pedidos"><DataField>pedidos</DataField></Field>
        <Field Name="puntualidad"><DataField>puntualidad</DataField></Field>
        <Field Name="dias"><DataField>dias</DataField></Field>
        <Field Name="nota"><DataField>nota</DataField></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Desde">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue><DataSetReference><DataSetName>R01_Fechas</DataSetName><ValueField>desde</ValueField></DataSetReference></DefaultValue>
      <Prompt>Desde (fecha de compra)</Prompt>
    </ReportParameter>
    <ReportParameter Name="Hasta">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue><DataSetReference><DataSetName>R01_Fechas</DataSetName><ValueField>hasta</ValueField></DataSetReference></DefaultValue>
      <Prompt>Hasta (fecha de compra)</Prompt>
    </ReportParameter>
    <ReportParameter Name="EstadoCliente">
      <DataType>String</DataType>
      <DefaultValue><Values><Value>__TODOS__</Value></Values></DefaultValue>
      <Prompt>Estado del cliente</Prompt>
      <ValidValues><DataSetReference><DataSetName>R01_Estados</DataSetName><ValueField>valor</ValueField><LabelField>etiqueta</LabelField></DataSetReference></ValidValues>
    </ReportParameter>
  </ReportParameters>
  <ReportParametersLayout>
    <GridLayoutDefinition>
      <NumberOfColumns>3</NumberOfColumns>
      <NumberOfRows>1</NumberOfRows>
      <CellDefinitions>
        <CellDefinition><ColumnIndex>0</ColumnIndex><RowIndex>0</RowIndex><ParameterName>Desde</ParameterName></CellDefinition>
        <CellDefinition><ColumnIndex>1</ColumnIndex><RowIndex>0</RowIndex><ParameterName>Hasta</ParameterName></CellDefinition>
        <CellDefinition><ColumnIndex>2</ColumnIndex><RowIndex>0</RowIndex><ParameterName>EstadoCliente</ParameterName></CellDefinition>
      </CellDefinitions>
    </GridLayoutDefinition>
  </ReportParametersLayout>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="AvisoSinDatos">
            <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=If(IsNothing(Parameters!Desde.Value) OrElse IsNothing(Parameters!Hasta.Value), "Sin datos elegibles en el Data Mart para el período.", If(Parameters!Desde.Value &gt; Parameters!Hasta.Value, "Rango inválido: la fecha Desde debe ser anterior o igual a Hasta.", If(First(Fields!pedidos.Value, "R01_ResumenCabecera") = 0 AndAlso First(Fields!entregados.Value, "R01_ResumenDetalle") = 0, "Sin datos elegibles para el período y estado seleccionados.", "")))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#B91C1C</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs>
            <Top>0.1cm</Top><Left>0.2cm</Left><Height>0.7cm</Height><Width>18.0cm</Width>
