              </Style>
            </Textbox>
            <Textbox Name="Filtros">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>="Compra: " &amp; If(IsNothing(Parameters!Desde.Value), "—", Format(Parameters!Desde.Value, "dd/MM/yyyy")) &amp; " a " &amp; If(IsNothing(Parameters!Hasta.Value), "—", Format(Parameters!Hasta.Value, "dd/MM/yyyy")) &amp; "  |  Estado: " &amp; Parameters!EstadoCliente.Label &amp; "  |  Nota: " &amp; Parameters!NotaMin.Value &amp; " a " &amp; Parameters!NotaMax.Value</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>10pt</FontSize>
                        <FontWeight>Normal</FontWeight>
                        <Color>#FFFFFF</Color>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Left</TextAlign>
                  </Style>
                </Paragraph>
