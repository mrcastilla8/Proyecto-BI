                <TextRuns>
                  <TextRun>
                    <Value>=If(IsNothing(Parameters!Desde.Value) OrElse IsNothing(Parameters!Hasta.Value), "Sin datos para el período seleccionado.", If((Parameters!Desde.Value &gt; Parameters!Hasta.Value OrElse Parameters!Desde.Value &lt; First(Fields!desde.Value, "R06_Fechas") OrElse Parameters!Hasta.Value &gt; First(Fields!hasta.Value, "R06_Fechas") OrElse Parameters!NotaMin.Value &lt; 1 OrElse Parameters!NotaMax.Value &gt; 5 OrElse Parameters!NotaMin.Value &gt; Parameters!NotaMax.Value), "Revisa las fechas de compra y el rango de notas de 1 a 5.", If(CountRows("R06_Satisfaccion") = 0, "Sin datos para los filtros seleccionados.", "")))</Value>
