<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <Description>Satisfacción de clientes por mes de compra, estado y rango de nota consolidada.</Description>
  <DataSources>
    <DataSource Name="BI_OLIST_DW">
      <DataSourceReference>/OLIST360/DataSources/BI_OLIST_DW</DataSourceReference>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="R06_Fechas">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <CommandText><![CDATA[SELECT MIN(f.fecha) AS desde, MAX(f.fecha) AS hasta
FROM dw.FactPedidos AS p
JOIN dw.DimFecha AS f ON f.fecha_key = p.fecha_compra_key
WHERE f.fecha_key <> -1;
]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="desde">
          <DataField>desde</DataField>
        </Field>
        <Field Name="hasta">
          <DataField>hasta</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="R06_Estados">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <CommandText><![CDATA[SELECT estados.valor, estados.etiqueta
FROM (
    SELECT '__TODOS__' AS valor, N'Todos' AS etiqueta, 0 AS prioridad
    UNION ALL
    SELECT DISTINCT customer_state, customer_state, 1
    FROM dw.DimGeografiaCliente
    WHERE customer_state IS NOT NULL
    UNION ALL
    SELECT '__DESCONOCIDO__', N'Desconocido', 2
    WHERE EXISTS (
        SELECT 1 FROM dw.DimGeografiaCliente WHERE customer_state IS NULL
    )
) AS estados
ORDER BY estados.prioridad, estados.etiqueta;
]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="valor">
          <DataField>valor</DataField>
        </Field>
        <Field Name="etiqueta">
          <DataField>etiqueta</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="R06_Satisfaccion">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Desde">
            <Value>=Parameters!Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Hasta">
            <Value>=Parameters!Hasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EstadoCliente">
            <Value>=Parameters!EstadoCliente.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@NotaMin">
            <Value>=Parameters!NotaMin.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@NotaMax">
            <Value>=Parameters!NotaMax.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText><![CDATA[WITH Limites AS (
    SELECT MIN(f.fecha) AS fecha_minima, MAX(f.fecha) AS fecha_maxima
    FROM dw.FactPedidos AS p
    JOIN dw.DimFecha AS f ON f.fecha_key = p.fecha_compra_key
    WHERE f.fecha_key <> -1
),
Notas AS (
    SELECT f.anio, f.mes, g.customer_state,
           CONVERT(float, p.review_score) AS nota,
           CONVERT(int, FLOOR(p.review_score)) AS rango
    FROM dw.FactPedidos AS p
    JOIN dw.DimFecha AS f ON f.fecha_key = p.fecha_compra_key
    JOIN dw.DimGeografiaCliente AS g ON g.geografia_cliente_key = p.geografia_cliente_key
    CROSS JOIN Limites AS l
    WHERE f.fecha_key <> -1
      AND CAST(@Desde AS date) >= l.fecha_minima
      AND CAST(@Hasta AS date) <= l.fecha_maxima
      AND CAST(@Desde AS date) <= CAST(@Hasta AS date)
      AND f.fecha BETWEEN CAST(@Desde AS date) AND CAST(@Hasta AS date)
      AND (
          @EstadoCliente = '__TODOS__'
          OR (@EstadoCliente = '__DESCONOCIDO__' AND g.customer_state IS NULL)
          OR g.customer_state = @EstadoCliente
      )
      AND @NotaMin >= 1 AND @NotaMax <= 5 AND @NotaMin <= @NotaMax
      AND CONVERT(float, p.review_score) BETWEEN @NotaMin AND @NotaMax
)
SELECT GROUPING_ID(anio, mes, customer_state, rango) AS nivel,
       anio, mes, customer_state, rango,
       COUNT_BIG(*) AS notas_validas, AVG(nota) AS nota
FROM Notas
GROUP BY GROUPING SETS ((anio, mes), (customer_state), (rango), ())
HAVING COUNT_BIG(*) > 0
ORDER BY nivel, anio, mes, customer_state, rango;
]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="nivel">
          <DataField>nivel</DataField>
        </Field>
        <Field Name="anio">
          <DataField>anio</DataField>
        </Field>
        <Field Name="mes">
          <DataField>mes</DataField>
        </Field>
        <Field Name="customer_state">
          <DataField>customer_state</DataField>
        </Field>
        <Field Name="rango">
          <DataField>rango</DataField>
        </Field>
        <Field Name="notas_validas">
          <DataField>notas_validas</DataField>
        </Field>
        <Field Name="nota">
          <DataField>nota</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Desde">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>R06_Fechas</DataSetName>
          <ValueField>desde</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Desde</Prompt>
    </ReportParameter>
    <ReportParameter Name="Hasta">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>R06_Fechas</DataSetName>
          <ValueField>hasta</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Hasta</Prompt>
    </ReportParameter>
    <ReportParameter Name="EstadoCliente">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>__TODOS__</Value>
        </Values>
      </DefaultValue>
      <Prompt>Estado del cliente</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>R06_Estados</DataSetName>
          <ValueField>valor</ValueField>
          <LabelField>etiqueta</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="NotaMin">
      <DataType>Float</DataType>
      <DefaultValue>
        <Values>
          <Value>1</Value>
        </Values>
      </DefaultValue>
      <Prompt>Nota mínima</Prompt>
    </ReportParameter>
    <ReportParameter Name="NotaMax">
      <DataType>Float</DataType>
      <DefaultValue>
        <Values>
          <Value>5</Value>
        </Values>
      </DefaultValue>
      <Prompt>Nota máxima</Prompt>
    </ReportParameter>
  </ReportParameters>
  <ReportParametersLayout>
    <GridLayoutDefinition>
      <NumberOfColumns>3</NumberOfColumns>
      <NumberOfRows>2</NumberOfRows>
      <CellDefinitions>
        <CellDefinition>
