              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>OLIST 360°  |  R06 · Satisfacción</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>17pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                        <Color>#FFFFFF</Color>
                      </Style>
                    </TextRun>
