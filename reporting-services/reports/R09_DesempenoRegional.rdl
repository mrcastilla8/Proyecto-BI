<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <Description>Indicadores de Olist por estado y ciudad del cliente con totales recalculados.</Description>
  <DataSources>
    <DataSource Name="BI_OLIST_DW">
      <DataSourceReference>/OLIST360/DataSources/BI_OLIST_DW</DataSourceReference>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="R06_Fechas">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <CommandText><![CDATA[SELECT MIN(f.fecha) AS desde, MAX(f.fecha) AS hasta
FROM dw.FactPedidos AS p
JOIN dw.DimFecha AS f ON f.fecha_key = p.fecha_compra_key
WHERE f.fecha_key <> -1;
]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="desde">
          <DataField>desde</DataField>
        </Field>
        <Field Name="hasta">
          <DataField>hasta</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="R06_Estados">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <CommandText><![CDATA[SELECT estados.valor, estados.etiqueta
FROM (
    SELECT '__TODOS__' AS valor, N'Todos' AS etiqueta, 0 AS prioridad
    UNION ALL
    SELECT DISTINCT customer_state, customer_state, 1
    FROM dw.DimGeografiaCliente
    WHERE customer_state IS NOT NULL
    UNION ALL
    SELECT '__DESCONOCIDO__', N'Desconocido', 2
    WHERE EXISTS (
        SELECT 1 FROM dw.DimGeografiaCliente WHERE customer_state IS NULL
    )
) AS estados
ORDER BY estados.prioridad, estados.etiqueta;
]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="valor">
          <DataField>valor</DataField>
        </Field>
        <Field Name="etiqueta">
          <DataField>etiqueta</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="R09_Ciudades">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@EstadoCliente">
            <Value>=Parameters!EstadoCliente.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText><![CDATA[SELECT ciudades.valor, ciudades.etiqueta
FROM (
    SELECT CONVERT(nvarchar(200), '__TODOS__') AS valor, N'Todas' AS etiqueta, 0 AS prioridad
    UNION ALL
    SELECT DISTINCT g.customer_city, g.customer_city, 1
    FROM dw.DimGeografiaCliente AS g
    WHERE g.customer_city IS NOT NULL
      AND (@EstadoCliente = '__TODOS__'
           OR g.customer_state = @EstadoCliente
           OR (@EstadoCliente = '__DESCONOCIDO__' AND g.customer_state IS NULL))
    UNION ALL
    SELECT '__DESCONOCIDO__', N'Desconocida', 2
    WHERE EXISTS (
        SELECT 1 FROM dw.DimGeografiaCliente AS g
        WHERE g.customer_city IS NULL
          AND (@EstadoCliente = '__TODOS__'
               OR g.customer_state = @EstadoCliente
               OR (@EstadoCliente = '__DESCONOCIDO__' AND g.customer_state IS NULL))
    )
) AS ciudades
ORDER BY ciudades.prioridad, ciudades.etiqueta;
]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="valor">
          <DataField>valor</DataField>
        </Field>
        <Field Name="etiqueta">
          <DataField>etiqueta</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="R09_DesempenoRegional">
      <Query>
        <DataSourceName>BI_OLIST_DW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Desde">
            <Value>=Parameters!Desde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Hasta">
            <Value>=Parameters!Hasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EstadoCliente">
            <Value>=Parameters!EstadoCliente.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Ciudad">
            <Value>=Parameters!Ciudad.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText><![CDATA[WITH Limites AS (
    SELECT MIN(f.fecha) AS desde, MAX(f.fecha) AS hasta
    FROM dw.FactPedidos AS p
    JOIN dw.DimFecha AS f ON f.fecha_key = p.fecha_compra_key
    WHERE f.fecha_key <> -1
),
Fechas AS (
    SELECT f.fecha_key
    FROM dw.DimFecha AS f
    CROSS JOIN Limites AS l
    WHERE f.fecha_key <> -1
      AND CAST(@Desde AS date) >= l.desde
      AND CAST(@Hasta AS date) <= l.hasta
      AND CAST(@Desde AS date) <= CAST(@Hasta AS date)
      AND f.fecha BETWEEN CAST(@Desde AS date) AND CAST(@Hasta AS date)
),
Geografia AS (
    SELECT g.geografia_cliente_key, g.customer_state AS estado, g.customer_city AS ciudad
    FROM dw.DimGeografiaCliente AS g
    WHERE (@EstadoCliente = '__TODOS__'
           OR (@EstadoCliente = '__DESCONOCIDO__' AND g.customer_state IS NULL)
           OR g.customer_state = @EstadoCliente)
      AND (@Ciudad = '__TODOS__'
           OR (@Ciudad = '__DESCONOCIDO__' AND g.customer_city IS NULL)
           OR g.customer_city = @Ciudad)
),
Detalle AS (
    SELECT GROUPING_ID(g.estado, g.ciudad) AS nivel, g.estado, g.ciudad,
           SUM(d.price) AS ventas,
           COUNT_BIG(DISTINCT d.order_id) AS entregados,
           CONVERT(float, SUM(d.price)) / NULLIF(COUNT_BIG(DISTINCT d.order_id), 0) AS ticket,
           SUM(d.freight_value) AS flete
    FROM dw.FactDetallePedido AS d
    JOIN Fechas AS f ON f.fecha_key = d.fecha_compra_key
    JOIN Geografia AS g ON g.geografia_cliente_key = d.geografia_cliente_key
    WHERE d.order_status = 'delivered'
    GROUP BY GROUPING SETS ((g.estado, g.ciudad), (g.estado), ())
    HAVING COUNT_BIG(*) > 0
),
Pedidos AS (
    SELECT GROUPING_ID(g.estado, g.ciudad) AS nivel, g.estado, g.ciudad,
           COUNT_BIG(*) AS pedidos,
           AVG(CASE
               WHEN p.order_status = 'delivered'
                AND p.fecha_entrega_real_key <> -1 AND p.fecha_entrega_estimada_key <> -1
               THEN CONVERT(float, CASE
                   WHEN p.fecha_entrega_real_key <= p.fecha_entrega_estimada_key THEN 1
                   ELSE 0
               END)
           END) AS puntualidad,
           AVG(CASE
               WHEN p.order_status = 'delivered' AND p.fecha_entrega_real_key <> -1
               THEN CONVERT(float, DATEDIFF_BIG(SECOND, p.order_purchase_timestamp,
                                               p.order_delivered_customer_date)) / 86400.0
           END) AS dias,
           AVG(CONVERT(float, p.review_score)) AS nota
    FROM dw.FactPedidos AS p
    JOIN Fechas AS f ON f.fecha_key = p.fecha_compra_key
    JOIN Geografia AS g ON g.geografia_cliente_key = p.geografia_cliente_key
    GROUP BY GROUPING SETS ((g.estado, g.ciudad), (g.estado), ())
    HAVING COUNT_BIG(*) > 0
),
Resultados AS (
    SELECT COALESCE(d.nivel, p.nivel) AS nivel,
           COALESCE(d.estado, p.estado) AS estado,
           COALESCE(d.ciudad, p.ciudad) AS ciudad,
           d.ventas, d.entregados, d.ticket, d.flete, p.pedidos, p.puntualidad, p.dias, p.nota
    FROM Detalle AS d
    FULL OUTER JOIN Pedidos AS p ON d.nivel = p.nivel
      AND (d.estado = p.estado OR (d.estado IS NULL AND p.estado IS NULL))
      AND (d.ciudad = p.ciudad OR (d.ciudad IS NULL AND p.ciudad IS NULL))
)
SELECT nivel, estado, ciudad, ventas, entregados, ticket, flete, pedidos, puntualidad, dias, nota,
       CASE WHEN nivel = 1 THEN CONVERT(float, ventas) /
           NULLIF(MAX(CASE WHEN nivel = 1 THEN CONVERT(float, ventas) END) OVER (), 0)
       END AS ventas_relativas,
       MAX(CASE WHEN nivel = 3 THEN puntualidad END) OVER () AS puntualidad_total,
       MAX(CASE WHEN nivel = 3 THEN nota END) OVER () AS nota_total
FROM Resultados
ORDER BY nivel DESC, estado, ciudad;
]]></CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="nivel">
          <DataField>nivel</DataField>
        </Field>
        <Field Name="estado">
          <DataField>estado</DataField>
        </Field>
        <Field Name="ciudad">
          <DataField>ciudad</DataField>
        </Field>
        <Field Name="ventas">
          <DataField>ventas</DataField>
        </Field>
        <Field Name="entregados">
          <DataField>entregados</DataField>
        </Field>
        <Field Name="ticket">
          <DataField>ticket</DataField>
        </Field>
        <Field Name="flete">
          <DataField>flete</DataField>
        </Field>
        <Field Name="pedidos">
          <DataField>pedidos</DataField>
        </Field>
        <Field Name="puntualidad">
          <DataField>puntualidad</DataField>
        </Field>
        <Field Name="dias">
          <DataField>dias</DataField>
        </Field>
        <Field Name="nota">
          <DataField>nota</DataField>
        </Field>
        <Field Name="ventas_relativas">
          <DataField>ventas_relativas</DataField>
        </Field>
        <Field Name="puntualidad_total">
          <DataField>puntualidad_total</DataField>
        </Field>
        <Field Name="nota_total">
          <DataField>nota_total</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Desde">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>R06_Fechas</DataSetName>
          <ValueField>desde</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Desde</Prompt>
    </ReportParameter>
    <ReportParameter Name="Hasta">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>R06_Fechas</DataSetName>
          <ValueField>hasta</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Hasta</Prompt>
    </ReportParameter>
    <ReportParameter Name="EstadoCliente">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>__TODOS__</Value>
        </Values>
      </DefaultValue>
      <Prompt>Estado del cliente</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>R06_Estados</DataSetName>
          <ValueField>valor</ValueField>
          <LabelField>etiqueta</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="Ciudad">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>__TODOS__</Value>
        </Values>
      </DefaultValue>
      <Prompt>Ciudad del cliente</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>R09_Ciudades</DataSetName>
          <ValueField>valor</ValueField>
          <LabelField>etiqueta</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
  </ReportParameters>
