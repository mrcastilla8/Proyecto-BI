              <Paragraph><TextRuns><TextRun><Value>Lotes no terminales, fallidos o por revisar</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!control.Value &lt;&gt; "CONCILIADO", 1, 0), "R10_AuditoriaETL")</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#D97706</Color><Format>N0</Format></Style></TextRun></TextRuns><Style /></Paragraph>
