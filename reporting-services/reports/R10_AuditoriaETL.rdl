          </Textbox>
          <Textbox Name="TitResumen">
            <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Resumen de ejecuciones por tipo de proceso, fuente y estado (conteo de lotes; no suma reintentos como carga vigente)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs>
