<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources><DataSource Name="BI_OLIST_DW"><DataSourceReference>/OLIST360/DataSources/BI_OLIST_DW</DataSourceReference><rd:DataSourceID>6d89b9c0-4c61-4334-b7b0-097f6d8fdf2b</rd:DataSourceID></DataSource></DataSources>
  <DataSets>
    <DataSet Name="Cabecera"><Query><DataSourceName>BI_OLIST_DW</DataSourceName><QueryParameters><QueryParameter Name="@OrderId"><Value>=Parameters!OrderId.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT p.order_id,p.order_status,p.order_purchase_timestamp,p.order_estimated_delivery_date,p.order_delivered_customer_date,g.customer_state,g.customer_city,p.payment_value_total,p.review_score FROM dw.FactPedidos p JOIN dw.DimGeografiaCliente g ON g.geografia_cliente_key=p.geografia_cliente_key WHERE p.order_id=@OrderId AND LEN(@OrderId) BETWEEN 1 AND 64;</CommandText></Query><Fields><Field Name="order_id"><DataField>order_id</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="order_status"><DataField>order_status</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="order_purchase_timestamp"><DataField>order_purchase_timestamp</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="order_estimated_delivery_date"><DataField>order_estimated_delivery_date</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="order_delivered_customer_date"><DataField>order_delivered_customer_date</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="customer_state"><DataField>customer_state</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="customer_city"><DataField>customer_city</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="payment_value_total"><DataField>payment_value_total</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="review_score"><DataField>review_score</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields></DataSet>
    <DataSet Name="Detalle"><Query><DataSourceName>BI_OLIST_DW</DataSourceName><QueryParameters><QueryParameter Name="@OrderId"><Value>=Parameters!OrderId.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT d.order_id,d.order_item_id,c.product_id,c.product_category_name_english,v.seller_id,d.price,d.freight_value,d.order_status FROM dw.FactDetallePedido d JOIN dw.DimProducto c ON c.producto_key=d.producto_key JOIN dw.DimVendedor v ON v.vendedor_key=d.vendedor_key WHERE d.order_id=@OrderId AND LEN(@OrderId) BETWEEN 1 AND 64 ORDER BY d.order_item_id;</CommandText></Query><Fields><Field Name="order_id"><DataField>order_id</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="order_item_id"><DataField>order_item_id</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="product_id"><DataField>product_id</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="product_category_name_english"><DataField>product_category_name_english</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="seller_id"><DataField>seller_id</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="price"><DataField>price</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="freight_value"><DataField>freight_value</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="order_status"><DataField>order_status</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet>
  </DataSets>
  <ReportParameters><ReportParameter Name="OrderId"><DataType>String</DataType><AllowBlank>false</AllowBlank><Prompt>OrderId (obligatorio, hasta 64 caracteres)</Prompt></ReportParameter></ReportParameters>
  <Body>
    <ReportItems>
      <Textbox Name="Titulo"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>R08  |  Ficha de pedido</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Titulo</rd:DefaultName><Top>0.3cm</Top><Left>0.3cm</Left><Height>1.1cm</Height><Width>17.8cm</Width><Style><BackgroundColor>#101C32</BackgroundColor><PaddingLeft>8pt</PaddingLeft><PaddingTop>5pt</PaddingTop><VerticalAlign>Middle</VerticalAlign></Style></Textbox>
      <Textbox Name="OrderId"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Pedido: &quot; &amp; Parameters!OrderId.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>OrderId</rd:DefaultName><Top>1.55cm</Top><Left>0.5cm</Left><Height>0.65cm</Height><Width>17.4cm</Width><Style /></Textbox>
      <Textbox Name="PedidoNoEncontrado"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Pedido no encontrado. Verifica el identificador ingresado.</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#B91C1C</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>PedidoNoEncontrado</rd:DefaultName><Top>2.2cm</Top><Left>0.5cm</Left><Height>0.8cm</Height><Width>17.4cm</Width><Visibility><Hidden>=CountRows(&quot;Cabecera&quot;) &gt; 0</Hidden></Visibility><Style><BackgroundColor>#FEF2F2</BackgroundColor><PaddingLeft>8pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="EstadoLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Estado</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(First(Fields!order_status.Value, &quot;Cabecera&quot;)), &quot;No disponible&quot;, CStr(First(Fields!order_status.Value, &quot;Cabecera&quot;)))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>EstadoLabel</rd:DefaultName><Top>2.35cm</Top><Left>0.5cm</Left><Height>1.1cm</Height><Width>4.1cm</Width><Visibility><Hidden>=CountRows(&quot;Cabecera&quot;) = 0</Hidden></Visibility><Style><BackgroundColor>#EAF0F7</BackgroundColor><PaddingLeft>7pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="FechaCompra"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Fecha de compra</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(First(Fields!order_purchase_timestamp.Value, &quot;Cabecera&quot;)), &quot;No disponible&quot;, Format(First(Fields!order_purchase_timestamp.Value, &quot;Cabecera&quot;), &quot;dd/MM/yyyy&quot;))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>FechaCompra</rd:DefaultName><Top>2.35cm</Top><Left>4.9cm</Left><Height>1.1cm</Height><Width>4.1cm</Width><Visibility><Hidden>=CountRows(&quot;Cabecera&quot;) = 0</Hidden></Visibility><Style><BackgroundColor>#EAF0F7</BackgroundColor><PaddingLeft>7pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="FechaPrometida"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Entrega prometida</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(First(Fields!order_estimated_delivery_date.Value, &quot;Cabecera&quot;)), &quot;No disponible&quot;, Format(First(Fields!order_estimated_delivery_date.Value, &quot;Cabecera&quot;), &quot;dd/MM/yyyy&quot;))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>FechaPrometida</rd:DefaultName><Top>2.35cm</Top><Left>9.3cm</Left><Height>1.1cm</Height><Width>4.1cm</Width><Visibility><Hidden>=CountRows(&quot;Cabecera&quot;) = 0</Hidden></Visibility><Style><BackgroundColor>#EAF0F7</BackgroundColor><PaddingLeft>7pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="FechaReal"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Entrega real</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(First(Fields!order_delivered_customer_date.Value, &quot;Cabecera&quot;)), &quot;No disponible&quot;, Format(First(Fields!order_delivered_customer_date.Value, &quot;Cabecera&quot;), &quot;dd/MM/yyyy&quot;))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>FechaReal</rd:DefaultName><Top>2.35cm</Top><Left>13.7cm</Left><Height>1.1cm</Height><Width>4.1cm</Width><Visibility><Hidden>=CountRows(&quot;Cabecera&quot;) = 0</Hidden></Visibility><Style><BackgroundColor>#EAF0F7</BackgroundColor><PaddingLeft>7pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="Ubicacion"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Ubicación del cliente</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(First(Fields!customer_city.Value, &quot;Cabecera&quot;)), &quot;No disponible&quot;, CStr(First(Fields!customer_city.Value, &quot;Cabecera&quot;))) &amp; &quot;, &quot; &amp; IIf(IsNothing(First(Fields!customer_state.Value, &quot;Cabecera&quot;)), &quot;No disponible&quot;, CStr(First(Fields!customer_state.Value, &quot;Cabecera&quot;)))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Ubicacion</rd:DefaultName><Top>3.65cm</Top><Left>0.5cm</Left><Height>1.05cm</Height><Width>5.6cm</Width><Visibility><Hidden>=CountRows(&quot;Cabecera&quot;) = 0</Hidden></Visibility><Style><BackgroundColor>#FFFFFF</BackgroundColor><Border><Style>Solid</Style><Color>#CBD5E1</Color></Border><PaddingLeft>7pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="PagoAgregado"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Pago agregado observado</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(First(Fields!payment_value_total.Value, &quot;Cabecera&quot;)), &quot;Sin dato&quot;, &quot;R$ &quot; &amp; Format(First(Fields!payment_value_total.Value, &quot;Cabecera&quot;), &quot;N2&quot;))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#2563EB</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>PagoAgregado</rd:DefaultName><Top>3.65cm</Top><Left>6.4cm</Left><Height>1.05cm</Height><Width>5.6cm</Width><Visibility><Hidden>=CountRows(&quot;Cabecera&quot;) = 0</Hidden></Visibility><Style><BackgroundColor>#FFFFFF</BackgroundColor><Border><Style>Solid</Style><Color>#CBD5E1</Color></Border><PaddingLeft>7pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="Calificacion"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Nota consolidada</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(First(Fields!review_score.Value, &quot;Cabecera&quot;)), &quot;Sin dato&quot;, Format(First(Fields!review_score.Value, &quot;Cabecera&quot;), &quot;N2&quot;))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#0D9488</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Calificacion</rd:DefaultName><Top>3.65cm</Top><Left>12.3cm</Left><Height>1.05cm</Height><Width>5.5cm</Width><Visibility><Hidden>=CountRows(&quot;Cabecera&quot;) = 0</Hidden></Visibility><Style><BackgroundColor>#FFFFFF</BackgroundColor><Border><Style>Solid</Style><Color>#CBD5E1</Color></Border><PaddingLeft>7pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="TituloDetalle"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Detalle de ítems · montos por línea, independientes del pago agregado</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>TituloDetalle</rd:DefaultName><Top>5cm</Top><Left>0.5cm</Left><Height>0.65cm</Height><Width>17.4cm</Width><Visibility><Hidden>=CountRows(&quot;Cabecera&quot;) = 0</Hidden></Visibility><Style><Border><Bottom><Style>Solid</Style><Color>#CBD5E1</Color></Bottom></Border><PaddingBottom>3pt</PaddingBottom></Style></Textbox>
      <Tablix Name="TablaItems"><TablixBody>
        <TablixColumns><TablixColumn><Width>1.4cm</Width></TablixColumn><TablixColumn><Width>2.6cm</Width></TablixColumn><TablixColumn><Width>3.8cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.4cm</Width></TablixColumn><TablixColumn><Width>2.4cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn></TablixColumns>
        <TablixRows>
          <TablixRow><Height>0.65cm</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="HItem"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Ítem</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>HItem</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HProducto"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Producto</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>HProducto</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HCategoria"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Categoría</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>HCategoria</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HVendedor"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Vendedor</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>HVendedor</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HPrecio"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Precio</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>HPrecio</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingRight>3pt</PaddingRight><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HFlete"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Flete</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>HFlete</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingRight>3pt</PaddingRight><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HEstado"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Estado</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>HEstado</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          </TablixCells></TablixRow>
          <TablixRow><Height>0.55cm</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="DItem"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!order_item_id.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>DItem</rd:DefaultName><Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;)</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DProducto"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!product_id.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>DProducto</rd:DefaultName><Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;)</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DCategoria"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!product_category_name_english.Value), &quot;Sin categoría&quot;, Fields!product_category_name_english.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>DCategoria</rd:DefaultName><Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;)</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DVendedor"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!seller_id.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>DVendedor</rd:DefaultName><Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;)</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DPrecio"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!price.Value), &quot;Sin dato&quot;, &quot;R$ &quot; &amp; Format(Fields!price.Value, &quot;N2&quot;))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>DPrecio</rd:DefaultName><Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;)</BackgroundColor><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DFlete"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!freight_value.Value), &quot;Sin dato&quot;, &quot;R$ &quot; &amp; Format(Fields!freight_value.Value, &quot;N2&quot;))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>DFlete</rd:DefaultName><Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;)</BackgroundColor><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DEstado"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!order_status.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>7pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>DEstado</rd:DefaultName><Style><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;)</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          </TablixCells></TablixRow>
