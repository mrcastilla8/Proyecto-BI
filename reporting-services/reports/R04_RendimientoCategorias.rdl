<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"><Description>Rendimiento de categorías y productos entregados por fecha de compra, con subtotales recalculados en SQL.</Description><DataSources><DataSource Name="BI_OLIST_DW"><DataSourceReference>/OLIST360/DataSources/BI_OLIST_DW</DataSourceReference></DataSource></DataSources><DataSets><DataSet Name="R04_Fechas"><Query><DataSourceName>BI_OLIST_DW</DataSourceName><CommandText><![CDATA[SELECT MIN(f.fecha) AS desde, MAX(f.fecha) AS hasta
FROM dw.FactPedidos AS p
JOIN dw.DimFecha AS f ON f.fecha_key = p.fecha_compra_key
WHERE f.fecha_key <> -1;
]]></CommandText><Timeout>60</Timeout></Query><Fields><Field Name="desde"><DataField>desde</DataField></Field><Field Name="hasta"><DataField>hasta</DataField></Field></Fields></DataSet><DataSet Name="R04_Categorias"><Query><DataSourceName>BI_OLIST_DW</DataSourceName><CommandText><![CDATA[SELECT categorias.valor, categorias.etiqueta
FROM (
    SELECT '__TODOS__' AS valor, N'Todas' AS etiqueta, 0 AS prioridad
    UNION ALL
    SELECT DISTINCT product_category_name_english, product_category_name_english, 1
    FROM dw.DimProducto
    WHERE product_category_name_english IS NOT NULL
    UNION ALL
    SELECT '__DESCONOCIDO__', N'Desconocida', 2
    WHERE EXISTS (
        SELECT 1 FROM dw.DimProducto WHERE product_category_name_english IS NULL
    )
) AS categorias
ORDER BY categorias.prioridad, categorias.etiqueta;
]]></CommandText><Timeout>60</Timeout></Query><Fields><Field Name="valor"><DataField>valor</DataField></Field><Field Name="etiqueta"><DataField>etiqueta</DataField></Field></Fields></DataSet><DataSet Name="R04_RendimientoCategorias"><Query><DataSourceName>BI_OLIST_DW</DataSourceName><QueryParameters><QueryParameter Name="@Desde"><Value>=Parameters!Desde.Value</Value></QueryParameter><QueryParameter Name="@Hasta"><Value>=Parameters!Hasta.Value</Value></QueryParameter><QueryParameter Name="@Categoria"><Value>=Parameters!Categoria.Value</Value></QueryParameter></QueryParameters><CommandText><![CDATA[SELECT GROUPING_ID(c.product_category_name_english, c.product_id) AS nivel,
       c.product_category_name_english AS categoria,
       c.product_id,
       SUM(d.price) AS ventas,
       COUNT_BIG(DISTINCT d.order_id) AS entregados,
       CONVERT(float, SUM(d.price)) / NULLIF(COUNT_BIG(DISTINCT d.order_id), 0) AS ticket,
       SUM(d.freight_value) AS flete
FROM dw.FactDetallePedido AS d
JOIN dw.DimFecha AS f ON f.fecha_key = d.fecha_compra_key
JOIN dw.DimProducto AS c ON c.producto_key = d.producto_key
WHERE d.order_status = 'delivered'
  AND d.fecha_compra_key <> -1
  AND f.fecha >= CAST(@Desde AS date)
  AND f.fecha <= CAST(@Hasta AS date)
  AND CAST(@Desde AS date) <= CAST(@Hasta AS date)
  AND (
      @Categoria = '__TODOS__'
      OR (@Categoria = '__DESCONOCIDO__' AND c.product_category_name_english IS NULL)
      OR c.product_category_name_english = @Categoria
  )
GROUP BY GROUPING SETS ((c.product_category_name_english, c.product_id), (c.product_category_name_english), ())
ORDER BY nivel DESC, categoria, c.product_id;
]]></CommandText><Timeout>60</Timeout></Query><Fields><Field Name="nivel"><DataField>nivel</DataField></Field><Field Name="categoria"><DataField>categoria</DataField></Field><Field Name="product_id"><DataField>product_id</DataField></Field><Field Name="ventas"><DataField>ventas</DataField></Field><Field Name="entregados"><DataField>entregados</DataField></Field><Field Name="ticket"><DataField>ticket</DataField></Field><Field Name="flete"><DataField>flete</DataField></Field></Fields></DataSet></DataSets><ReportParameters><ReportParameter Name="Desde"><DataType>DateTime</DataType><Nullable>true</Nullable><DefaultValue><DataSetReference><DataSetName>R04_Fechas</DataSetName><ValueField>desde</ValueField></DataSetReference></DefaultValue><Prompt>Desde (fecha de compra)</Prompt></ReportParameter><ReportParameter Name="Hasta"><DataType>DateTime</DataType><Nullable>true</Nullable><DefaultValue><DataSetReference><DataSetName>R04_Fechas</DataSetName><ValueField>hasta</ValueField></DataSetReference></DefaultValue><Prompt>Hasta (fecha de compra)</Prompt></ReportParameter><ReportParameter Name="Categoria"><DataType>String</DataType><DefaultValue><Values><Value>__TODOS__</Value></Values></DefaultValue><Prompt>Categoría</Prompt><ValidValues><DataSetReference><DataSetName>R04_Categorias</DataSetName><ValueField>valor</ValueField><LabelField>etiqueta</LabelField></DataSetReference></ValidValues></ReportParameter></ReportParameters><ReportParametersLayout><GridLayoutDefinition><NumberOfColumns>3</NumberOfColumns><NumberOfRows>1</NumberOfRows><CellDefinitions><CellDefinition><ColumnIndex>0</ColumnIndex><RowIndex>0</RowIndex><ParameterName>Desde</ParameterName></CellDefinition><CellDefinition><ColumnIndex>1</ColumnIndex><RowIndex>0</RowIndex><ParameterName>Hasta</ParameterName></CellDefinition><CellDefinition><ColumnIndex>2</ColumnIndex><RowIndex>0</RowIndex><ParameterName>Categoria</ParameterName></CellDefinition></CellDefinitions></GridLayoutDefinition></ReportParametersLayout><ReportSections><ReportSection><Body><ReportItems><Textbox Name="SinDatos"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=If(IsNothing(Parameters!Desde.Value) OrElse IsNothing(Parameters!Hasta.Value), "Sin datos para el período seleccionado.", If(Parameters!Desde.Value &gt; Parameters!Hasta.Value, "La fecha Desde debe ser anterior o igual a Hasta.", If(CountRows("R04_RendimientoCategorias") = 0, "Sin datos para los filtros seleccionados.", "")))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0.05cm</Top><Left>0cm</Left><Height>0.65cm</Height><Width>26.4cm</Width><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom></Style><Visibility><Hidden>=CountRows("R04_RendimientoCategorias") &gt; 0</Hidden></Visibility></Textbox><Chart Name="TopCategorias"><ChartCategoryHierarchy><ChartMembers><ChartMember><Group Name="TopCategoriasCat"><GroupExpressions><GroupExpression>=IIf(Fields!nivel.Value = 3, "__TOTAL__", IIf(IsNothing(Fields!categoria.Value), "__DESCONOCIDO__", Fields!categoria.Value))</GroupExpression></GroupExpressions><Filters><Filter><FilterExpression>=Sum(Fields!ventas.Value)</FilterExpression><Operator>TopN</Operator><FilterValues><FilterValue>=10</FilterValue></FilterValues></Filter></Filters></Group><SortExpressions><SortExpression><Value>=Sum(Fields!ventas.Value)</Value></SortExpression></SortExpressions><Label>=IIf(IsNothing(Fields!categoria.Value), "Desconocida", Fields!categoria.Value)</Label></ChartMember></ChartMembers></ChartCategoryHierarchy><ChartSeriesHierarchy><ChartMembers><ChartMember><Label>Ventas</Label></ChartMember></ChartMembers></ChartSeriesHierarchy><ChartData><ChartSeriesCollection><ChartSeries Name="Ventas"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!ventas.Value)</Y></ChartDataPointValues><ChartDataLabel><Style /></ChartDataLabel><Style><Color>#2563EB</Color></Style><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style /></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries></ChartSeriesCollection></ChartData><ChartAreas><ChartArea Name="Default"><ChartCategoryAxes><ChartAxis Name="Primary"><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#475569</Color></Style><ChartAxisTitle><Caption /><Style><FontSize>8pt</FontSize></Style></ChartAxisTitle><ChartMajorGridLines><Enabled>False</Enabled><Style><Border><Color>#E2E8F0</Color></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><ChartMinorTickMarks><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><Minimum>NaN</Minimum><Maximum>NaN</Maximum><ChartAxisScaleBreak><Style /></ChartAxisScaleBreak><Interval>1</Interval></ChartAxis></ChartCategoryAxes><ChartValueAxes><ChartAxis Name="Primary"><Style><Format>'R$' #,##0</Format><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#475569</Color></Style><ChartAxisTitle><Caption /><Style><FontSize>8pt</FontSize></Style></ChartAxisTitle><ChartMajorGridLines><Enabled>True</Enabled><Style><Border><Color>#E2E8F0</Color></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><ChartMinorTickMarks><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><Minimum>NaN</Minimum><Maximum>NaN</Maximum><ChartAxisScaleBreak><Style /></ChartAxisScaleBreak></ChartAxis></ChartValueAxes><Style><BackgroundColor>#FFFFFF</BackgroundColor></Style></ChartArea></ChartAreas><ChartLegends><ChartLegend Name="Default"><Hidden>true</Hidden><Style /><ChartLegendTitle><Caption /><Style /></ChartLegendTitle><HeaderSeparatorColor>Black</HeaderSeparatorColor><ColumnSeparatorColor>Black</ColumnSeparatorColor></ChartLegend></ChartLegends><ChartTitles><ChartTitle Name="Titulo"><Caption>Top 10 categorías por ventas de productos entregados (R$)</Caption><Style><FontFamily>Segoe UI</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color></Style></ChartTitle></ChartTitles><Palette>BrightPastel</Palette><ChartBorderSkin><Style><BackgroundColor>Gray</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType><Color>White</Color></Style></ChartBorderSkin><ChartNoDataMessage Name="SinDatos"><Caption>Sin datos para los filtros seleccionados.</Caption><Style /></ChartNoDataMessage><DataSetName>R04_RendimientoCategorias</DataSetName><Filters><Filter><FilterExpression>=Fields!nivel.Value</FilterExpression><Operator>Equal</Operator><FilterValues><FilterValue>=CInt(1)</FilterValue></FilterValues></Filter></Filters><Top>0.75cm</Top><Left>0cm</Left><Height>6.6cm</Height><Width>26.4cm</Width><Style><Border><Color>#CBD5E1</Color><Style>Solid</Style></Border><BackgroundColor>#FFFFFF</BackgroundColor></Style><Visibility><Hidden>=CountRows("R04_RendimientoCategorias") = 0</Hidden></Visibility></Chart><Tablix Name="Categorias"><TablixBody><TablixColumns><TablixColumn><Width>9.2cm</Width></TablixColumn><TablixColumn><Width>4.3cm</Width></TablixColumn><TablixColumn><Width>4.3cm</Width></TablixColumn><TablixColumn><Width>4.3cm</Width></TablixColumn><TablixColumn><Width>4.3cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="R04Cab0"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Categoría › producto (ID)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#101C32</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="R04Cab1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Ventas (R$)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#101C32</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="R04Cab2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Pedidos entregados</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#101C32</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="R04Cab3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Ticket (R$)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#101C32</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="R04Cab4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Flete (R$)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#101C32</BackgroundColor></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="CatEtiqueta"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!categoria.Value), "Desconocida", Fields!categoria.Value)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#EAF0F7</BackgroundColor><BottomBorder><Color>#CBD5E1</Color><Style>Solid</Style></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CatVentas"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!nivel.Value = 1, Fields!ventas.Value, Nothing))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#EAF0F7</BackgroundColor><BottomBorder><Color>#CBD5E1</Color><Style>Solid</Style></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CatEntregados"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!nivel.Value = 1, Fields!entregados.Value, Nothing))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color><Format>N0</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#EAF0F7</BackgroundColor><BottomBorder><Color>#CBD5E1</Color><Style>Solid</Style></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CatTicket"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!nivel.Value = 1, Fields!ticket.Value, Nothing))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#EAF0F7</BackgroundColor><BottomBorder><Color>#CBD5E1</Color><Style>Solid</Style></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CatFlete"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!nivel.Value = 1, Fields!flete.Value, Nothing))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#EAF0F7</BackgroundColor><BottomBorder><Color>#CBD5E1</Color><Style>Solid</Style></BottomBorder></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="ProdEtiqueta"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!product_id.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#14233B</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EAF0F7", "#FFFFFF")</BackgroundColor><BottomBorder><Color>#CBD5E1</Color><Style>Solid</Style></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProdVentas"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ventas.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Normal</FontWeight><Color>#14233B</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EAF0F7", "#FFFFFF")</BackgroundColor><BottomBorder><Color>#CBD5E1</Color><Style>Solid</Style></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProdEntregados"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!entregados.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Normal</FontWeight><Color>#14233B</Color><Format>N0</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EAF0F7", "#FFFFFF")</BackgroundColor><BottomBorder><Color>#CBD5E1</Color><Style>Solid</Style></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProdTicket"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ticket.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Normal</FontWeight><Color>#14233B</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EAF0F7", "#FFFFFF")</BackgroundColor><BottomBorder><Color>#CBD5E1</Color><Style>Solid</Style></BottomBorder></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ProdFlete"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!flete.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Normal</FontWeight><Color>#14233B</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>=IIf(RowNumber(Nothing) Mod 2 = 0, "#EAF0F7", "#FFFFFF")</BackgroundColor><BottomBorder><Color>#CBD5E1</Color><Style>Solid</Style></BottomBorder></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="TotalEtiqueta"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Total general (recalculado)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#101C32</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="TotalVentas"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!nivel.Value = 3, Fields!ventas.Value, Nothing))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#101C32</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="TotalEntregados"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!nivel.Value = 3, Fields!entregados.Value, Nothing))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color><Format>N0</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#101C32</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="TotalTicket"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!nivel.Value = 3, Fields!ticket.Value, Nothing))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft><PaddingRight>3mm</PaddingRight><PaddingTop>1mm</PaddingTop><PaddingBottom>1mm</PaddingBottom><BackgroundColor>#101C32</BackgroundColor></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="TotalFlete"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(Fields!nivel.Value = 3, Fields!flete.Value, Nothing))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>3mm</PaddingLeft