<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources><DataSource Name="BI_OLIST_DW"><DataSourceReference>/OLIST360/DataSources/BI_OLIST_DW</DataSourceReference><rd:DataSourceID>f6c2e9c0-71be-4407-8e27-24a01c5b00a7</rd:DataSourceID></DataSource></DataSources>
  <DataSets>
    <DataSet Name="FechasCompra"><Query><DataSourceName>BI_OLIST_DW</DataSourceName><CommandText>SELECT MIN(f.fecha) AS Desde, MAX(f.fecha) AS Hasta FROM dw.FactPedidos AS p JOIN dw.DimFecha AS f ON f.fecha_key = p.fecha_compra_key WHERE p.fecha_compra_key &lt;&gt; -1 AND f.fecha IS NOT NULL;</CommandText></Query><Fields><Field Name="Desde"><DataField>Desde</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Hasta"><DataField>Hasta</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields></DataSet>
    <DataSet Name="EstadosPedido"><Query><DataSourceName>BI_OLIST_DW</DataSourceName><CommandText>WITH valores AS (SELECT 0 AS orden, N'__TODOS__' AS valor, N'Todos los estados' AS etiqueta UNION ALL SELECT 2, p.order_status, p.order_status FROM dw.FactPedidos AS p WHERE p.order_status IS NOT NULL AND p.order_status NOT IN (N'__TODOS__', N'__DESCONOCIDO__') GROUP BY p.order_status) SELECT valor, etiqueta FROM valores ORDER BY orden, etiqueta;&#10;</CommandText></Query><Fields><Field Name="valor"><DataField>valor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="etiqueta"><DataField>etiqueta</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet>
    <DataSet Name="DatosR07"><Query><DataSourceName>BI_OLIST_DW</DataSourceName><QueryParameters><QueryParameter Name="@Desde"><Value>=Parameters!Desde.Value</Value></QueryParameter><QueryParameter Name="@Hasta"><Value>=Parameters!Hasta.Value</Value></QueryParameter><QueryParameter Name="@EstadoPedido"><Value>=Parameters!EstadoPedido.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT GROUPING_ID(f.anio,f.mes,p.order_status) AS nivel,f.anio,f.mes,p.order_status,COUNT_BIG(*) AS pedidos,COUNT_BIG(p.payment_value_total) AS con_pago,COUNT_BIG(*)-COUNT_BIG(p.payment_value_total) AS sin_pago,SUM(p.payment_value_total) AS importe_observado FROM dw.FactPedidos p JOIN dw.DimFecha f ON f.fecha_key=p.fecha_compra_key WHERE p.fecha_compra_key &lt;&gt; -1 AND f.fecha &gt;= CAST(@Desde AS date) AND f.fecha &lt;= CAST(@Hasta AS date) AND CAST(@Desde AS date) &lt;= CAST(@Hasta AS date) AND (@EstadoPedido = '__TODOS__' OR (@EstadoPedido = '__DESCONOCIDO__' AND p.order_status IS NULL) OR p.order_status = @EstadoPedido) GROUP BY GROUPING SETS ((f.anio,f.mes,p.order_status),(f.anio,f.mes),()) HAVING COUNT_BIG(*) &gt; 0 ORDER BY nivel,f.anio,f.mes,p.order_status;&#10;</CommandText></Query><Fields><Field Name="nivel"><DataField>nivel</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="anio"><DataField>anio</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="mes"><DataField>mes</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="order_status"><DataField>order_status</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="pedidos"><DataField>pedidos</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="con_pago"><DataField>con_pago</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="sin_pago"><DataField>sin_pago</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="importe_observado"><DataField>importe_observado</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields></DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Desde"><DataType>DateTime</DataType><DefaultValue><DataSetReference><DataSetName>FechasCompra</DataSetName><ValueField>Desde</ValueField></DataSetReference></DefaultValue><Prompt>Desde (compra)</Prompt></ReportParameter>
    <ReportParameter Name="Hasta"><DataType>DateTime</DataType><DefaultValue><DataSetReference><DataSetName>FechasCompra</DataSetName><ValueField>Hasta</ValueField></DataSetReference></DefaultValue><Prompt>Hasta (compra)</Prompt></ReportParameter>
    <ReportParameter Name="EstadoPedido"><DataType>String</DataType><DefaultValue><Values><Value>__TODOS__</Value></Values></DefaultValue><ValidValues><DataSetReference><DataSetName>EstadosPedido</DataSetName><ValueField>valor</ValueField><LabelField>etiqueta</LabelField></DataSetReference></ValidValues><Prompt>Estado del pedido</Prompt></ReportParameter>
  </ReportParameters>
  <ReportSections><ReportSection><Body>
    <ReportItems>
      <Textbox Name="Titulo"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>R07  |  Importes pagados</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Titulo</rd:DefaultName><Top>0.3cm</Top><Left>0.3cm</Left><Height>1.1cm</Height><Width>26.4cm</Width><Style><BackgroundColor>#101C32</BackgroundColor><PaddingLeft>8pt</PaddingLeft><PaddingTop>5pt</PaddingTop><VerticalAlign>Middle</VerticalAlign></Style></Textbox>
      <Textbox Name="Subtitulo"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Importes observados por pedido · compra &quot; &amp; Format(Parameters!Desde.Value, &quot;dd/MM/yyyy&quot;) &amp; &quot; — &quot; &amp; Format(Parameters!Hasta.Value, &quot;dd/MM/yyyy&quot;)</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Subtitulo</rd:DefaultName><Top>1.55cm</Top><Left>0.5cm</Left><Height>0.65cm</Height><Width>26cm</Width><Style><PaddingLeft>2pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign></Style></Textbox>
      <Textbox Name="AvisoRango"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Revisa las fechas: Desde debe ser anterior o igual a Hasta. La consulta de datos no se ejecuta para este rango.</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#9A3412</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>AvisoRango</rd:DefaultName><Top>2.2cm</Top><Left>0.5cm</Left><Height>0.7cm</Height><Width>26cm</Width><Visibility><Hidden>=Parameters!Desde.Value &lt;= Parameters!Hasta.Value</Hidden></Visibility><Style><BackgroundColor>#FFF7ED</BackgroundColor><PaddingLeft>7pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox>
      <Textbox Name="TotalImporte"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>IMPORTE OBSERVADO</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=If(IsNothing(Max(IIf(Fields!nivel.Value = 7, Fields!importe_observado.Value, Nothing), "DatosR07")), CObj("Sin pagos observados"), CObj(Max(IIf(Fields!nivel.Value = 7, Fields!importe_observado.Value, Nothing), "DatosR07")))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#2563EB</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>TotalImporte</rd:DefaultName><Top>3.1cm</Top><Left>0.5cm</Left><Height>1.45cm</Height><Width>8.4cm</Width><Style><BackgroundColor>#FFFFFF</BackgroundColor><Border><Style>Solid</Style><Color>#CBD5E1</Color></Border><PaddingLeft>8pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="TotalPedidos"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>PEDIDOS</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=If(IsNothing(Max(IIf(Fields!nivel.Value = 7, Fields!pedidos.Value, Nothing), "DatosR07")), CObj("Sin pedidos"), CObj(Max(IIf(Fields!nivel.Value = 7, Fields!pedidos.Value, Nothing), "DatosR07")))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color><Format>N0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>TotalPedidos</rd:DefaultName><Top>3.1cm</Top><Left>9.5cm</Left><Height>1.45cm</Height><Width>5cm</Width><Style><BackgroundColor>#FFFFFF</BackgroundColor><Border><Style>Solid</Style><Color>#CBD5E1</Color></Border><PaddingLeft>8pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="PedidosConPago"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>CON PAGO OBSERVADO</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=If(IsNothing(Max(IIf(Fields!nivel.Value = 7, Fields!con_pago.Value, Nothing), "DatosR07")), CObj("Sin datos"), CObj(Max(IIf(Fields!nivel.Value = 7, Fields!con_pago.Value, Nothing), "DatosR07")))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#0D9488</Color><Format>N0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>PedidosConPago</rd:DefaultName><Top>3.1cm</Top><Left>15.5cm</Left><Height>1.45cm</Height><Width>5.3cm</Width><Style><BackgroundColor>#FFFFFF</BackgroundColor><Border><Style>Solid</Style><Color>#CBD5E1</Color></Border><PaddingLeft>8pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="PedidosSinPago"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>SIN PAGO OBSERVADO</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#475569</Color></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>=If(IsNothing(Max(IIf(Fields!nivel.Value = 7, Fields!sin_pago.Value, Nothing), "DatosR07")), CObj("Sin datos"), CObj(Max(IIf(Fields!nivel.Value = 7, Fields!sin_pago.Value, Nothing), "DatosR07")))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#D97706</Color><Format>N0</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>PedidosSinPago</rd:DefaultName><Top>3.1cm</Top><Left>21.6cm</Left><Height>1.45cm</Height><Width>4.9cm</Width><Style><BackgroundColor>#FFFFFF</BackgroundColor><Border><Style>Solid</Style><Color>#CBD5E1</Color></Border><PaddingLeft>8pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox>
      <Textbox Name="TituloTabla"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Detalle por mes y estado · incluye subtotales y total recalculado</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>TituloTabla</rd:DefaultName><Top>4.9cm</Top><Left>0.5cm</Left><Height>0.65cm</Height><Width>26cm</Width><Style><BottomBorder><Style>Solid</Style><Color>#CBD5E1</Color></BottomBorder><PaddingBottom>3pt</PaddingBottom></Style></Textbox>
      <Tablix Name="TablaImportes"><TablixBody>
        <TablixColumns><TablixColumn><Width>1.8cm</Width></TablixColumn><TablixColumn><Width>1.8cm</Width></TablixColumn><TablixColumn><Width>6cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>7.8cm</Width></TablixColumn></TablixColumns>
        <TablixRows>
          <TablixRow><Height>0.65cm</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="HAnio"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Año</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>HAnio</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HMes"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Mes</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>HMes</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HAgrupacion"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Estado / nivel</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>HAgrupacion</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HPedidos"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Pedidos</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>HPedidos</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingRight>4pt</PaddingRight><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HConPago"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Con pago</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>HConPago</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingRight>4pt</PaddingRight><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HSinPago"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Sin pago</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>HSinPago</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingRight>4pt</PaddingRight><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="HImporte"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Importe observado (BRL)</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>HImporte</rd:DefaultName><Style><BackgroundColor>#101C32</BackgroundColor><PaddingRight>4pt</PaddingRight><PaddingTop>4pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          </TablixCells></TablixRow>
          <TablixRow><Height>0.55cm</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="DAnio"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!anio.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>DAnio</rd:DefaultName><Style><BackgroundColor>=IIf(Fields!nivel.Value = 7, &quot;#EAF0F7&quot;, IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;))</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DMes"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!mes.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>DMes</rd:DefaultName><Style><BackgroundColor>=IIf(Fields!nivel.Value = 7, &quot;#EAF0F7&quot;, IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;))</BackgroundColor><Format>00</Format><PaddingLeft>4pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DAgrupacion"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(Fields!nivel.Value = 7, &quot;Total del período&quot;, IIf(Fields!nivel.Value = 1, &quot;Subtotal mensual&quot;, IIf(IsNothing(Fields!order_status.Value), &quot;Estado sin dato&quot;, CStr(Fields!order_status.Value))))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>DAgrupacion</rd:DefaultName><Style><BackgroundColor>=IIf(Fields!nivel.Value = 7, &quot;#EAF0F7&quot;, IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;))</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DPedidos"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!pedidos.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>DPedidos</rd:DefaultName><Style><BackgroundColor>=IIf(Fields!nivel.Value = 7, &quot;#EAF0F7&quot;, IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;))</BackgroundColor><Format>N0</Format><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DConPago"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!con_pago.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>DConPago</rd:DefaultName><Style><BackgroundColor>=IIf(Fields!nivel.Value = 7, &quot;#EAF0F7&quot;, IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;))</BackgroundColor><Format>N0</Format><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DSinPago"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!sin_pago.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#14233B</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>DSinPago</rd:DefaultName><Style><BackgroundColor>=IIf(Fields!nivel.Value = 7, &quot;#EAF0F7&quot;, IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;))</BackgroundColor><Format>N0</Format><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="DImporte"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=If(IsNothing(Fields!importe_observado.Value), CObj("Sin pago observado"), CObj(Fields!importe_observado.Value))</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#14233B</Color><Format>'R$' #,##0.00</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>DImporte</rd:DefaultName><Style><BackgroundColor>=IIf(Fields!nivel.Value = 7, &quot;#EAF0F7&quot;, IIf(RowNumber(Nothing) Mod 2 = 0, &quot;#F8FAFC&quot;, &quot;#FFFFFF&quot;))</BackgroundColor><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          </TablixCells></TablixRow>
        </TablixRows>
