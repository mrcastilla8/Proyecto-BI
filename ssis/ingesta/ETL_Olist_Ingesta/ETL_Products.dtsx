      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{323E2ECF-6701-477F-A081-650CB3DBAAA6}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON; IF DB_NAME()&lt;&gt;'BI_OLIST' THROW 51900,'SQL_DATABASE',1;&#xA;CREATE TABLE #Lote(batch_id bigint NOT NULL, expected int NOT NULL, session_id int NOT NULL);&#xA;CREATE TABLE #FilasIngesta(source_row_number bigint NOT NULL PRIMARY KEY,[product_id] nvarchar(65) NULL,[product_category_name] nvarchar(201) NULL,[product_name_lenght] nvarchar(96) NULL,[product_description_lenght] nvarchar(96) NULL,[product_photos_qty] nvarchar(96) NULL,[product_weight_g] nvarchar(96) NULL,[product_length_cm] nvarchar(96) NULL,[product_height_cm] nvarchar(96) NULL,[product_width_cm] nvarchar(96) NULL);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Identificar y bloquear lote"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{97A73975-712D-4E3F-A649-DD2AA8BC3897}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="Identificar y bloquear lote"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{323E2ECF-6701-477F-A081-650CB3DBAAA6}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;DECLARE @hash char(64)=?, @expected int=?, @lock int;&#xA;DECLARE @resource nvarchar(255)=CONCAT('BIOLIST:ingesta:Products:',@hash,':1.0.0');&#xA;EXEC @lock=sys.sp_getapplock @Resource=@resource,@LockMode='Exclusive',@LockOwner='Session',@LockTimeout=5000;&#xA;IF @lock&lt;0 THROW 51910,'BATCH_LOCK_TIMEOUT',1;&#xA;&#xA;DECLARE @matches int,@batch bigint,@status varchar(12);&#xA;SELECT @matches=COUNT(*),@batch=MAX(batch_id),@status=MAX(status)&#xA;FROM audit.Batch&#xA;WHERE source_name=N'Products' AND source_file=N'olist_products_dataset.csv'&#xA;  AND source_sha256=@hash AND contract_version='1.0.0';&#xA;IF @matches&gt;1 THROW 51911,'BATCH_AMBIGUOUS',1;&#xA;IF @matches=0&#xA;BEGIN&#xA;    INSERT audit.Batch(source_name,source_file,source_sha256,contract_version,status)&#xA;    VALUES(N'Products',N'olist_products_dataset.csv',@hash,'1.0.0','PENDING');&#xA;    SET @batch=SCOPE_IDENTITY();&#xA;END;&#xA;INSERT #Lote VALUES(@batch,@expected,@@SPID);&#xA;SELECT CONVERT(int,CASE WHEN @status='COMPLETE' THEN 1 ELSE 0 END) AS omit;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::Omitir" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::SourceHash"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="64" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::RowsExpected"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
