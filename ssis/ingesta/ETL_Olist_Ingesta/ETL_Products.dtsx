    <DTS:Executable
      DTS:refId="Package\Publicar y conciliar"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{E3C7CD16-56E9-4A4D-ABE5-2924FD25DD50}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="Publicar y conciliar"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{323E2ECF-6701-477F-A081-650CB3DBAAA6}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @batch bigint, @expected int, @session int, @read int=?;&#xA;SELECT @batch=batch_id,@expected=expected,@session=session_id FROM #Lote;&#xA;IF @session IS NULL OR @session&lt;&gt;@@SPID THROW 51920,'LOTE_SESSION',1;&#xA;&#xA;BEGIN TRY&#xA;    IF @read&lt;&gt;@expected OR @read&lt;&gt;(SELECT COUNT(*) FROM #FilasIngesta)&#xA;        OR EXISTS(SELECT 1 FROM #FilasIngesta WHERE source_row_number NOT BETWEEN 1 AND @read)&#xA;        THROW 51921,'CSV_RECONCILIATION',1;&#xA;&#xA;    SELECT f.source_row_number, parsed.*, fault.field_name, fault.reason_code INTO #Clasificadas&#xA;FROM #FilasIngesta AS f CROSS APPLY (SELECT TRY_CONVERT(VARCHAR(64),NULLIF(f.[product_id],N'')) AS c0,TRY_CONVERT(NVARCHAR(200),NULLIF(f.[product_category_name],N'')) AS c1,TRY_CONVERT(INT,NULLIF(f.[product_name_lenght],N'')) AS c2,TRY_CONVERT(INT,NULLIF(f.[product_description_lenght],N'')) AS c3,TRY_CONVERT(INT,NULLIF(f.[product_photos_qty],N'')) AS c4,TRY_CONVERT(DECIMAL(12,3),NULLIF(f.[product_weight_g],N'')) AS c5,TRY_CONVERT(DECIMAL(12,3),NULLIF(f.[product_length_cm],N'')) AS c6,TRY_CONVERT(DECIMAL(12,3),NULLIF(f.[product_height_cm],N'')) AS c7,TRY_CONVERT(DECIMAL(12,3),NULLIF(f.[product_width_cm],N'')) AS c8) AS parsed&#xA;OUTER APPLY (SELECT TOP (1) field_name,reason_code FROM (VALUES&#xA;(1,'product_id',CASE WHEN f.[product_id] IS NULL OR DATALENGTH(f.[product_id])=0 THEN 'REQUIRED' WHEN NULLIF(TRIM(f.[product_id]),N'') IS NULL THEN 'REQUIRED' WHEN DATALENGTH(f.[product_id])&gt;128 THEN 'TEXT_LENGTH' WHEN CONVERT(varbinary(max),f.[product_id])&lt;&gt;CONVERT(varbinary(max),CONVERT(nvarchar(max),CONVERT(varchar(max),f.[product_id]))) THEN 'TEXT_CODEPAGE' END),&#xA;(2,'product_category_name',CASE WHEN f.[product_category_name] IS NULL OR DATALENGTH(f.[product_category_name])=0 THEN NULL WHEN DATALENGTH(f.[product_category_name])&gt;400 THEN 'TEXT_LENGTH' END),&#xA;(3,'product_name_lenght',CASE WHEN f.[product_name_lenght] IS NULL OR DATALENGTH(f.[product_name_lenght])=0 THEN NULL WHEN parsed.c2 IS NULL OR (CASE WHEN LEFT(f.[product_name_lenght],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_name_lenght],2,96) ELSE f.[product_name_lenght] END) COLLATE Latin1_General_100_BIN2 LIKE N'%[^0-9]%' OR (CASE WHEN LEFT(f.[product_name_lenght],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_name_lenght],2,96) ELSE f.[product_name_lenght] END) COLLATE Latin1_General_100_BIN2 NOT LIKE N'%[0-9]%' OR DATALENGTH(f.[product_name_lenght])&lt;&gt;DATALENGTH(TRIM(f.[product_name_lenght])) THEN 'NUMBER_FORMAT' END),&#xA;(4,'product_description_lenght',CASE WHEN f.[product_description_lenght] IS NULL OR DATALENGTH(f.[product_description_lenght])=0 THEN NULL WHEN parsed.c3 IS NULL OR (CASE WHEN LEFT(f.[product_description_lenght],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_description_lenght],2,96) ELSE f.[product_description_lenght] END) COLLATE Latin1_General_100_BIN2 LIKE N'%[^0-9]%' OR (CASE WHEN LEFT(f.[product_description_lenght],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_description_lenght],2,96) ELSE f.[product_description_lenght] END) COLLATE Latin1_General_100_BIN2 NOT LIKE N'%[0-9]%' OR DATALENGTH(f.[product_description_lenght])&lt;&gt;DATALENGTH(TRIM(f.[product_description_lenght])) THEN 'NUMBER_FORMAT' END),&#xA;(5,'product_photos_qty',CASE WHEN f.[product_photos_qty] IS NULL OR DATALENGTH(f.[product_photos_qty])=0 THEN NULL WHEN parsed.c4 IS NULL OR (CASE WHEN LEFT(f.[product_photos_qty],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_photos_qty],2,96) ELSE f.[product_photos_qty] END) COLLATE Latin1_General_100_BIN2 LIKE N'%[^0-9]%' OR (CASE WHEN LEFT(f.[product_photos_qty],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_photos_qty],2,96) ELSE f.[product_photos_qty] END) COLLATE Latin1_General_100_BIN2 NOT LIKE N'%[0-9]%' OR DATALENGTH(f.[product_photos_qty])&lt;&gt;DATALENGTH(TRIM(f.[product_photos_qty])) THEN 'NUMBER_FORMAT' END),&#xA;(6,'product_weight_g',CASE WHEN f.[product_weight_g] IS NULL OR DATALENGTH(f.[product_weight_g])=0 THEN NULL WHEN parsed.c5 IS NULL OR (CASE WHEN LEFT(f.[product_weight_g],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_weight_g],2,96) ELSE f.[product_weight_g] END) COLLATE Latin1_General_100_BIN2 LIKE N'%[^0-9.]%' OR (CASE WHEN LEFT(f.[product_weight_g],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_weight_g],2,96) ELSE f.[product_weight_g] END) COLLATE Latin1_General_100_BIN2 NOT LIKE N'%[0-9]%' OR DATALENGTH(f.[product_weight_g])&lt;&gt;DATALENGTH(TRIM(f.[product_weight_g])) THEN 'NUMBER_FORMAT' WHEN CHARINDEX(N'.',f.[product_weight_g])&gt;0 AND LEN(f.[product_weight_g])-CHARINDEX(N'.',f.[product_weight_g])&gt;3 THEN 'DECIMAL_SCALE' END),&#xA;(7,'product_length_cm',CASE WHEN f.[product_length_cm] IS NULL OR DATALENGTH(f.[product_length_cm])=0 THEN NULL WHEN parsed.c6 IS NULL OR (CASE WHEN LEFT(f.[product_length_cm],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_length_cm],2,96) ELSE f.[product_length_cm] END) COLLATE Latin1_General_100_BIN2 LIKE N'%[^0-9.]%' OR (CASE WHEN LEFT(f.[product_length_cm],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_length_cm],2,96) ELSE f.[product_length_cm] END) COLLATE Latin1_General_100_BIN2 NOT LIKE N'%[0-9]%' OR DATALENGTH(f.[product_length_cm])&lt;&gt;DATALENGTH(TRIM(f.[product_length_cm])) THEN 'NUMBER_FORMAT' WHEN CHARINDEX(N'.',f.[product_length_cm])&gt;0 AND LEN(f.[product_length_cm])-CHARINDEX(N'.',f.[product_length_cm])&gt;3 THEN 'DECIMAL_SCALE' END),&#xA;(8,'product_height_cm',CASE WHEN f.[product_height_cm] IS NULL OR DATALENGTH(f.[product_height_cm])=0 THEN NULL WHEN parsed.c7 IS NULL OR (CASE WHEN LEFT(f.[product_height_cm],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_height_cm],2,96) ELSE f.[product_height_cm] END) COLLATE Latin1_General_100_BIN2 LIKE N'%[^0-9.]%' OR (CASE WHEN LEFT(f.[product_height_cm],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_height_cm],2,96) ELSE f.[product_height_cm] END) COLLATE Latin1_General_100_BIN2 NOT LIKE N'%[0-9]%' OR DATALENGTH(f.[product_height_cm])&lt;&gt;DATALENGTH(TRIM(f.[product_height_cm])) THEN 'NUMBER_FORMAT' WHEN CHARINDEX(N'.',f.[product_height_cm])&gt;0 AND LEN(f.[product_height_cm])-CHARINDEX(N'.',f.[product_height_cm])&gt;3 THEN 'DECIMAL_SCALE' END),&#xA;(9,'product_width_cm',CASE WHEN f.[product_width_cm] IS NULL OR DATALENGTH(f.[product_width_cm])=0 THEN NULL WHEN parsed.c8 IS NULL OR (CASE WHEN LEFT(f.[product_width_cm],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_width_cm],2,96) ELSE f.[product_width_cm] END) COLLATE Latin1_General_100_BIN2 LIKE N'%[^0-9.]%' OR (CASE WHEN LEFT(f.[product_width_cm],1) IN (N'-',N'+') THEN SUBSTRING(f.[product_width_cm],2,96) ELSE f.[product_width_cm] END) COLLATE Latin1_General_100_BIN2 NOT LIKE N'%[0-9]%' OR DATALENGTH(f.[product_width_cm])&lt;&gt;DATALENGTH(TRIM(f.[product_width_cm])) THEN 'NUMBER_FORMAT' WHEN CHARINDEX(N'.',f.[product_width_cm])&gt;0 AND LEN(f.[product_width_cm])-CHARINDEX(N'.',f.[product_width_cm])&gt;3 THEN 'DECIMAL_SCALE' END)&#xA;) AS defectos(pos,field_name,reason_code) WHERE reason_code IS NOT NULL ORDER BY pos) AS fault;&#xA;    BEGIN TRAN;&#xA;    DECLARE @started datetime2(0)=SYSDATETIME();&#xA;    UPDATE audit.Batch WITH (UPDLOCK,HOLDLOCK) SET&#xA;        started_at=CASE WHEN status='FAILED' AND started_at&gt;=@started THEN DATEADD(second,1,started_at) ELSE @started END,&#xA;        status='RUNNING',finished_at=NULL,error_message=NULL,rows_read=0,rows_accepted=0,rows_rejected=0&#xA;    WHERE batch_id=@batch AND status IN ('PENDING','RUNNING','FAILED');&#xA;    IF @@ROWCOUNT&lt;&gt;1 THROW 51922,'BATCH_STATE',1;&#xA;&#xA;    DELETE stg.[Products] WHERE batch_id=@batch;&#xA;    DELETE audit.Reject WHERE batch_id=@batch;&#xA;    INSERT stg.[Products](batch_id,source_row_number,[product_id],[product_category_name],[product_name_lenght],[product_description_lenght],[product_photos_qty],[product_weight_g],[product_length_cm],[product_height_cm],[product_width_cm])&#xA;    SELECT @batch,source_row_number,c0,c1,c2,c3,c4,c5,c6,c7,c8&#xA;    FROM #Clasificadas WHERE reason_code IS NULL;&#xA;    DECLARE @accepted int=@@ROWCOUNT;&#xA;    &#xA;&#xA;    INSERT audit.Reject(batch_id,source_name,source_row_number,field_name,reason_code,reason)&#xA;    SELECT @batch,N'Products',source_row_number,field_name,reason_code,&#xA;        CASE reason_code WHEN 'REQUIRED' THEN N'Campo requerido vacío'&#xA;            WHEN 'TEXT_LENGTH' THEN N'Texto excede la longitud contractual'&#xA;            WHEN 'TEXT_CODEPAGE' THEN N'Texto no representable en el destino'&#xA;            WHEN 'ZIP_FORMAT' THEN N'Prefijo postal inválido'&#xA;            WHEN 'DATETIME_FORMAT' THEN N'Fecha u hora inválida'&#xA;            WHEN 'DECIMAL_SCALE' THEN N'Exceso de decimales para el destino'&#xA;            WHEN 'REVIEW_SCORE_RANGE' THEN N'Puntuación fuera de 1 a 5'&#xA;            ELSE N'Número inválido para el tipo de destino' END&#xA;    FROM #Clasificadas WHERE reason_code IS NOT NULL;&#xA;    DECLARE @rejected int=@@ROWCOUNT;&#xA;    IF @read&lt;&gt;@accepted+@rejected THROW 51923,'BATCH_RECONCILIATION',1;&#xA;&#xA;    UPDATE audit.Batch SET status='COMPLETE',&#xA;        finished_at=CASE WHEN SYSDATETIME()&lt;started_at THEN started_at ELSE SYSDATETIME() END,&#xA;        rows_read=@read, rows_accepted=@accepted, rows_rejected=@rejected,&#xA;        execution_context=CONCAT('SSIS Products; SPID=',@@SPID)&#xA;    WHERE batch_id=@batch;&#xA;    COMMIT;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF XACT_STATE()&lt;&gt;0 ROLLBACK;&#xA;    DECLARE @error int=ERROR_NUMBER();&#xA;    BEGIN TRAN;&#xA;    UPDATE audit.Batch SET status='RUNNING',started_at=DATEADD(second,1,started_at),&#xA;        finished_at=NULL,error_message=NULL WHERE batch_id=@batch AND status='FAILED';&#xA;    UPDATE audit.Batch SET status='FAILED',&#xA;        finished_at=CASE WHEN SYSDATETIME()&lt;started_at THEN started_at ELSE SYSDATETIME() END,&#xA;        error_message=CONCAT('PUBLICAR/',@error),&#xA;        execution_context=CONCAT('SSIS Products; SPID=',@@SPID)&#xA;    WHERE batch_id=@batch AND status IN ('PENDING','RUNNING');&#xA;    COMMIT;&#xA;    THROW;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::RowsRead"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
