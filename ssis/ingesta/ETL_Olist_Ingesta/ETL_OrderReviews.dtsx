    <DTS:Executable
      DTS:refId="Package\Publicar y conciliar"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{20C5ADDF-B379-41FF-A739-7A49857AFED6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="Publicar y conciliar"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C5B0D83A-AE73-46B8-802D-D33917DCC2D0}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @batch bigint, @expected int, @session int, @read int=?;&#xA;SELECT @batch=batch_id,@expected=expected,@session=session_id FROM #Lote;&#xA;IF @session IS NULL OR @session&lt;&gt;@@SPID THROW 51920,'LOTE_SESSION',1;&#xA;&#xA;BEGIN TRY&#xA;    IF @read&lt;&gt;@expected OR @read&lt;&gt;(SELECT COUNT(*) FROM #FilasIngesta)&#xA;        OR EXISTS(SELECT 1 FROM #FilasIngesta WHERE source_row_number NOT BETWEEN 1 AND @read)&#xA;        THROW 51921,'CSV_RECONCILIATION',1;&#xA;&#xA;    SELECT f.source_row_number, parsed.*, fault.field_name, fault.reason_code INTO #Clasificadas&#xA;FROM #FilasIngesta AS f CROSS APPLY (SELECT TRY_CONVERT(VARCHAR(64),CASE WHEN DATALENGTH(f.[review_id])=0 THEN NULL ELSE f.[review_id] END) AS c0,TRY_CONVERT(VARCHAR(64),CASE WHEN DATALENGTH(f.[order_id])=0 THEN NULL ELSE f.[order_id] END) AS c1,TRY_CONVERT(TINYINT,NULLIF(f.[review_score],N'')) AS c2,TRY_CONVERT(NVARCHAR(1000),CASE WHEN DATALENGTH(f.[review_comment_title])=0 THEN NULL ELSE f.[review_comment_title] END) AS c3,TRY_CONVERT(NVARCHAR(4000),CASE WHEN DATALENGTH(f.[review_comment_message])=0 THEN NULL ELSE f.[review_comment_message] END) AS c4,TRY_CONVERT(DATETIME2(0),NULLIF(f.[review_creation_date],N''),120) AS c5,TRY_CONVERT(DATETIME2(0),NULLIF(f.[review_answer_timestamp],N''),120) AS c6) AS parsed&#xA;OUTER APPLY (SELECT TOP (1) field_name,reason_code FROM (VALUES&#xA;(1,'review_id',CASE WHEN f.[review_id] IS NULL OR DATALENGTH(f.[review_id])=0 THEN 'REQUIRED' WHEN DATALENGTH(f.[review_id])&gt;128 THEN 'TEXT_LENGTH' WHEN CONVERT(varbinary(max),f.[review_id])&lt;&gt;CONVERT(varbinary(max),CONVERT(nvarchar(max),CONVERT(varchar(max),f.[review_id]))) THEN 'TEXT_CODEPAGE' END),&#xA;(2,'order_id',CASE WHEN f.[order_id] IS NULL OR DATALENGTH(f.[order_id])=0 THEN 'REQUIRED' WHEN DATALENGTH(f.[order_id])&gt;128 THEN 'TEXT_LENGTH' WHEN CONVERT(varbinary(max),f.[order_id])&lt;&gt;CONVERT(varbinary(max),CONVERT(nvarchar(max),CONVERT(varchar(max),f.[order_id]))) THEN 'TEXT_CODEPAGE' END),&#xA;(3,'review_score',CASE WHEN f.[review_score] IS NULL OR DATALENGTH(f.[review_score])=0 THEN NULL WHEN parsed.c2 IS NULL OR (CASE WHEN LEFT(f.[review_score],1) IN (N'-',N'+') THEN SUBSTRING(f.[review_score],2,96) ELSE f.[review_score] END) COLLATE Latin1_General_100_BIN2 LIKE N'%[^0-9]%' OR (CASE WHEN LEFT(f.[review_score],1) IN (N'-',N'+') THEN SUBSTRING(f.[review_score],2,96) ELSE f.[review_score] END) COLLATE Latin1_General_100_BIN2 NOT LIKE N'%[0-9]%' OR DATALENGTH(f.[review_score])&lt;&gt;DATALENGTH(TRIM(f.[review_score])) THEN 'NUMBER_FORMAT' WHEN parsed.c2 NOT BETWEEN 1 AND 5 THEN 'REVIEW_SCORE_RANGE' END),&#xA;(4,'review_comment_title',CASE WHEN f.[review_comment_title] IS NULL OR DATALENGTH(f.[review_comment_title])=0 THEN NULL WHEN DATALENGTH(f.[review_comment_title])&gt;2000 THEN 'TEXT_LENGTH' END),&#xA;(5,'review_comment_message',CASE WHEN f.[review_comment_message] IS NULL OR DATALENGTH(f.[review_comment_message])=0 THEN NULL WHEN DATALENGTH(f.[review_comment_message])&gt;8000 THEN 'TEXT_LENGTH' END),&#xA;(6,'review_creation_date',CASE WHEN f.[review_creation_date] IS NULL OR DATALENGTH(f.[review_creation_date])=0 THEN NULL WHEN parsed.c5 IS NULL OR DATALENGTH(f.[review_creation_date])&lt;&gt;38 OR CONVERT(varbinary(max),f.[review_creation_date])&lt;&gt;CONVERT(varbinary(max),CONVERT(nvarchar(19),parsed.c5,120)) THEN 'DATETIME_FORMAT' END),&#xA;(7,'review_answer_timestamp',CASE WHEN f.[review_answer_timestamp] IS NULL OR DATALENGTH(f.[review_answer_timestamp])=0 THEN NULL WHEN parsed.c6 IS NULL OR DATALENGTH(f.[review_answer_timestamp])&lt;&gt;38 OR CONVERT(varbinary(max),f.[review_answer_timestamp])&lt;&gt;CONVERT(varbinary(max),CONVERT(nvarchar(19),parsed.c6,120)) THEN 'DATETIME_FORMAT' END)&#xA;) AS defectos(pos,field_name,reason_code) WHERE reason_code IS NOT NULL ORDER BY pos) AS fault;&#xA;    BEGIN TRAN;&#xA;    DECLARE @started datetime2(0)=SYSDATETIME();&#xA;    UPDATE audit.Batch WITH (UPDLOCK,HOLDLOCK) SET&#xA;        started_at=CASE WHEN status='FAILED' AND started_at&gt;=@started THEN DATEADD(second,1,started_at) ELSE @started END,&#xA;        status='RUNNING',finished_at=NULL,error_message=NULL,rows_read=0,rows_accepted=0,rows_rejected=0&#xA;    WHERE batch_id=@batch AND status IN ('PENDING','RUNNING','FAILED');&#xA;    IF @@ROWCOUNT&lt;&gt;1 THROW 51922,'BATCH_STATE',1;&#xA;&#xA;    DELETE stg.[OrderReviews] WHERE batch_id=@batch;&#xA;    DELETE audit.Reject WHERE batch_id=@batch;&#xA;    INSERT stg.[OrderReviews](batch_id,source_row_number,[review_id],[order_id],[review_score],[review_comment_title],[review_comment_message],[review_creation_date],[review_answer_timestamp])&#xA;    SELECT @batch,source_row_number,c0,c1,c2,c3,c4,c5,c6&#xA;    FROM #Clasificadas WHERE reason_code IS NULL;&#xA;    DECLARE @accepted int=@@ROWCOUNT;&#xA;    &#xA;&#xA;    INSERT audit.Reject(batch_id,source_name,source_row_number,field_name,reason_code,reason)&#xA;    SELECT @batch,N'OrderReviews',source_row_number,field_name,reason_code,&#xA;        CASE reason_code WHEN 'REQUIRED' THEN N'Campo requerido vacío'&#xA;            WHEN 'TEXT_LENGTH' THEN N'Texto excede la longitud contractual'&#xA;            WHEN 'TEXT_CODEPAGE' THEN N'Texto no representable en el destino'&#xA;            WHEN 'ZIP_FORMAT' THEN N'Prefijo postal inválido'&#xA;            WHEN 'DATETIME_FORMAT' THEN N'Fecha u hora inválida'&#xA;            WHEN 'DECIMAL_SCALE' THEN N'Exceso de decimales para el destino'&#xA;            WHEN 'REVIEW_SCORE_RANGE' THEN N'Puntuación fuera de 1 a 5'&#xA;            ELSE N'Número inválido para el tipo de destino' END&#xA;    FROM #Clasificadas WHERE reason_code IS NOT NULL;&#xA;    DECLARE @rejected int=@@ROWCOUNT;&#xA;    IF @read&lt;&gt;@accepted+@rejected THROW 51923,'BATCH_RECONCILIATION',1;&#xA;&#xA;    UPDATE audit.Batch SET status='COMPLETE',&#xA;        finished_at=CASE WHEN SYSDATETIME()&lt;started_at THEN started_at ELSE SYSDATETIME() END,&#xA;        rows_read=@read, rows_accepted=@accepted, rows_rejected=@rejected,&#xA;        execution_context=CONCAT('SSIS OrderReviews; SPID=',@@SPID)&#xA;    WHERE batch_id=@batch;&#xA;    COMMIT;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF XACT_STATE()&lt;&gt;0 ROLLBACK;&#xA;    DECLARE @error int=ERROR_NUMBER();&#xA;    BEGIN TRAN;&#xA;    UPDATE audit.Batch SET status='RUNNING',started_at=DATEADD(second,1,started_at),&#xA;        finished_at=NULL,error_message=NULL WHERE batch_id=@batch AND status='FAILED';&#xA;    UPDATE audit.Batch SET status='FAILED',&#xA;        finished_at=CASE WHEN SYSDATETIME()&lt;started_at THEN started_at ELSE SYSDATETIME() END,&#xA;        error_message=CONCAT('PUBLICAR/',@error),&#xA;        execution_context=CONCAT('SSIS OrderReviews; SPID=',@@SPID)&#xA;    WHERE batch_id=@batch AND status IN ('PENDING','RUNNING');&#xA;    COMMIT;&#xA;    THROW;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::RowsRead"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Registrar fallo del flujo"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:DTSID="{DDA0B54D-F2F2-472E-84A0-F0EB040714AA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:FailPackageOnFailure="True"
      DTS:LocaleID="-1"
      DTS:ObjectName="Registrar fallo del flujo"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C5B0D83A-AE73-46B8-802D-D33917DCC2D0}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @batch bigint=(SELECT batch_id FROM #Lote);&#xA;BEGIN TRAN;&#xA;UPDATE audit.Batch SET status='RUNNING',started_at=DATEADD(second,1,started_at),&#xA;    finished_at=NULL,error_message=NULL WHERE batch_id=@batch AND status='FAILED';&#xA;UPDATE audit.Batch SET status='FAILED',&#xA;    finished_at=CASE WHEN SYSDATETIME()&lt;started_at THEN started_at ELSE SYSDATETIME() END,&#xA;    error_message=N'DATA_FLOW: consultar el log de ejecución.',&#xA;    execution_context=CONCAT('SSIS OrderReviews; SPID=',@@SPID)&#xA;WHERE batch_id=@batch AND status IN ('PENDING','RUNNING');&#xA;COMMIT;&#xA;THROW 51924,'DATA_FLOW: falló el flujo SSIS',1;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
