      {
        "name": "FactPedidos",
        "description": "Una fila por pedido. Incluye pedidos sin líneas.",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "cliente_key",
            "dataType": "int64",
            "sourceColumn": "cliente_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "geografia_cliente_key",
            "dataType": "int64",
            "sourceColumn": "geografia_cliente_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "fecha_compra_key",
            "dataType": "int64",
            "sourceColumn": "fecha_compra_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "fecha_entrega_estimada_key",
            "dataType": "int64",
            "sourceColumn": "fecha_entrega_estimada_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "fecha_entrega_real_key",
            "dataType": "int64",
            "sourceColumn": "fecha_entrega_real_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "order_status",
            "dataType": "string",
            "sourceColumn": "order_status",
            "summarizeBy": "none"
          },
          {
            "name": "order_purchase_timestamp",
            "dataType": "dateTime",
            "sourceColumn": "order_purchase_timestamp",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "order_delivered_customer_date",
            "dataType": "dateTime",
            "sourceColumn": "order_delivered_customer_date",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "review_score",
            "dataType": "decimal",
            "sourceColumn": "review_score",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FactPedidos",
            "mode": "import",
            "source": {
              "type": "query",
              "dataSource": "BI_OLIST",
              "query": "SELECT [order_id], [cliente_key], [geografia_cliente_key], [fecha_compra_key], [fecha_entrega_estimada_key], [fecha_entrega_real_key], [order_status], [order_purchase_timestamp], [order_delivered_customer_date], [review_score] FROM [dw].[FactPedidos]"
            }
          }
        ],
        "measures": [
          {
            "name": "pedidos_totales",
            "description": "Pedidos distintos de cualquier estado, incluidos los que carecen de líneas.",
            "expression": "DISTINCTCOUNT ( 'FactPedidos'[order_id] )",
            "formatString": "#,0",
            "displayFolder": "Pedidos y ventas"
          },
          {
            "name": "porcentaje_entregas_a_tiempo",
            "description": "Proporción de entregas con fechas conocidas cuyo día real es anterior o igual al prometido.",
            "expression": [
              "VAR PedidosElegibles =",
              "    CALCULATETABLE (",
              "        'FactPedidos',",
              "        KEEPFILTERS ( 'FactPedidos'[order_status] = \"delivered\" ),",
              "        KEEPFILTERS ( 'FactPedidos'[fecha_entrega_real_key] <> -1 ),",
              "        KEEPFILTERS ( 'FactPedidos'[fecha_entrega_estimada_key] <> -1 )",
              "    )",
              "VAR PedidosATiempo =",
              "    FILTER (",
              "        PedidosElegibles,",
              "        'FactPedidos'[fecha_entrega_real_key] <= 'FactPedidos'[fecha_entrega_estimada_key]",
              "    )",
              "RETURN",
              "    DIVIDE ( COALESCE ( COUNTROWS ( PedidosATiempo ), 0 ), COUNTROWS ( PedidosElegibles ) )"
            ],
            "formatString": "0.00%",
            "displayFolder": "Logística"
          },
          {
            "name": "dias_promedio_entrega",
            "description": "Promedio de días transcurridos, con fracción de día, entre compra y entrega real.",
            "expression": [
              "CALCULATE (",
              "    AVERAGEX (",
              "        'FactPedidos',",
              "        DIVIDE (",
              "            DATEDIFF (",
              "                'FactPedidos'[order_purchase_timestamp],",
              "                'FactPedidos'[order_delivered_customer_date],",
              "                SECOND",
              "            ),",
              "            86400",
              "        )",
              "    ),",
              "    KEEPFILTERS ( 'FactPedidos'[order_status] = \"delivered\" ),",
              "    KEEPFILTERS ( 'FactPedidos'[fecha_compra_key] <> -1 ),",
              "    KEEPFILTERS ( 'FactPedidos'[fecha_entrega_real_key] <> -1 )",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Logística"
          },
          {
            "name": "calificacion_promedio",
            "description": "Promedio de las notas válidas consolidadas por pedido.",
            "expression": [
              "AVERAGEX (",
              "    'FactPedidos',",
              "    VAR Nota = 'FactPedidos'[review_score]",
              "    RETURN IF ( NOT ISBLANK ( Nota ), CONVERT ( Nota, DOUBLE ) )",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "Satisfacción"
          }
        ]
      },
      {
        "name": "FactDetallePedido",
        "description": "Una fila por pedido e ítem. Los filtros de producto y vendedor se aplican a este hecho.",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_item_id",
            "dataType": "int64",
            "sourceColumn": "order_item_id",
            "summarizeBy": "none"
          },
          {
            "name": "producto_key",
            "dataType": "int64",
            "sourceColumn": "producto_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "vendedor_key",
            "dataType": "int64",
            "sourceColumn": "vendedor_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "cliente_key",
            "dataType": "int64",
            "sourceColumn": "cliente_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "geografia_cliente_key",
            "dataType": "int64",
            "sourceColumn": "geografia_cliente_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "geografia_vendedor_key",
            "dataType": "int64",
            "sourceColumn": "geografia_vendedor_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "fecha_compra_key",
            "dataType": "int64",
            "sourceColumn": "fecha_compra_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "order_status",
            "dataType": "string",
            "sourceColumn": "order_status",
            "summarizeBy": "none"
          },
          {
            "name": "price",
            "dataType": "decimal",
            "sourceColumn": "price",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "freight_value",
            "dataType": "decimal",
            "sourceColumn": "freight_value",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FactDetallePedido",
            "mode": "import",
            "source": {
              "type": "query",
              "dataSource": "BI_OLIST",
              "query": "SELECT [order_id], [order_item_id], [producto_key], [vendedor_key], [cliente_key], [geografia_cliente_key], [geografia_vendedor_key], [fecha_compra_key], [order_status], [price], [freight_value] FROM [dw].[FactDetallePedido]"
            }
          }
        ],
        "measures": [
          {
            "name": "ventas_productos_entregados",
            "description": "Precio de líneas entregadas, sin flete. BRL.",
            "expression": "CALCULATE ( SUM ( 'FactDetallePedido'[price] ), KEEPFILTERS ( 'FactDetallePedido'[order_status] = \"delivered\" ) )",
            "formatString": "\"R$ \" #,0.00",
            "displayFolder": "Pedidos y ventas"
          },
          {
            "name": "pedidos_entregados_con_items",
            "description": "Pedidos distintos con líneas entregadas en el contexto filtrado.",
            "expression": "CALCULATE ( DISTINCTCOUNT ( 'FactDetallePedido'[order_id] ), KEEPFILTERS ( 'FactDetallePedido'[order_status] = \"delivered\" ) )",
            "formatString": "#,0",
            "displayFolder": "Pedidos y ventas"
          },
          {
            "name": "ticket_promedio_productos_entregados",
            "description": "Precio de productos por pedido entregado con líneas. BRL.",
            "expression": "DIVIDE ( CONVERT ( [ventas_productos_entregados], DOUBLE ), [pedidos_entregados_con_items] )",
            "formatString": "\"R$ \" #,0.00",
            "displayFolder": "Pedidos y ventas"
          },
          {
            "name": "flete_pedidos_entregados",
            "description": "Suma del flete de las líneas entregadas. BRL.",
            "expression": "CALCULATE ( SUM ( 'FactDetallePedido'[freight_value] ), KEEPFILTERS ( 'FactDetallePedido'[order_status] = \"delivered\" ) )",
            "formatString": "\"R$ \" #,0.00",
            "displayFolder": "Pedidos y ventas"
          }
        ]
      }
    ],
