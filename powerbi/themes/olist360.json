{
  "name": "OLIST 360",
  "dataColors": [
    "#2563EB",
    "#0D9488",
    "#101C32",
    "#D97706",
    "#475569",
    "#93C5FD",
    "#5EEAD4",
    "#94A3B8",
    "#059669",
    "#DC2626"
  ],
  "foreground": "#14233B",
  "foregroundNeutralSecondary": "#475569",
  "foregroundNeutralTertiary": "#64748B",
  "background": "#FFFFFF",
  "backgroundLight": "#F8FAFC",
  "backgroundNeutral": "#CBD5E1",
  "tableAccent": "#2563EB",
  "good": "#059669",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "maximum": "#2563EB",
  "center": "#93C5FD",
  "minimum": "#EAF0F7",
  "null": "#CBD5E1",
  "hyperlink": "#2563EB",
  "visitedHyperlink": "#101C32",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Semibold",
      "color": "#14233B"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#14233B"
    },
    "header": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#14233B"
    },
    "label": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#CBD5E1" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#14233B" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 14
          }
        ],
        "subTitle": [
          {
            "fontColor": { "solid": { "color": "#475569" } },
            "fontFamily": "Segoe UI",
            "fontSize": 11
          }
        ],
        "visualHeader": [
          {
            "background": { "solid": { "color": "#FFFFFF" } },
            "foreground": { "solid": { "color": "#475569" } },
            "border": { "solid": { "color": "#CBD5E1" } }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#475569" } },
            "fontSize": 11,
            "titleColor": { "solid": { "color": "#475569" } }
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#475569" } },
            "fontSize": 11,
            "titleColor": { "solid": { "color": "#475569" } },
            "gridlineColor": { "solid": { "color": "#E2E8F0" } }
          }
        ],
        "legend": [
          {
            "labelColor": { "solid": { "color": "#475569" } },
            "fontSize": 11
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#EAF0F7" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#EAF0F7" } },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "actionButton": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontalColor": { "solid": { "color": "#E2E8F0" } },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#101C32" } },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#14233B" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#14233B" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } }
          }
        ],
        "total": [
          {
            "fontFamily": "Segoe UI Semibold",
            "backColor": { "solid": { "color": "#EAF0F7" } }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#101C32" } },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#14233B" } }
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#14233B" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#14233B" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } }
          }
        ],
        "total": [
          {
            "fontFamily": "Segoe UI Semibold",
            "backColor": { "solid": { "color": "#EAF0F7" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": { "solid": { "color": "#14233B" } },
            "fontFamily": "Segoe UI Semibold",
            "textSize": 12
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#14233B" } },
            "textSize": 12
          }
        ]
      }
    }
  }
}
